[Unit]
Description=Pokelinux background Messages history owner
After=local-fs.target
[Service]
Type=simple
ExecStart=/usr/libexec/pokelinux/messages-service /run/pokelinux/messages /var/lib/pokelinux/receipts /var/lib/pokelinux/inbox
ExecStop=/usr/libexec/pokelinux/messages-stop /run/pokelinux/messages/admin.sock
RuntimeDirectory=pokelinux/messages
RuntimeDirectoryMode=0700
StateDirectory=pokelinux/receipts pokelinux/inbox
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
TasksMax=96
MemoryMax=512M
KillMode=mixed
TimeoutStopSec=5
Restart=no
[Install]
WantedBy=multi-user.target
