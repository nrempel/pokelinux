[Unit]
Description=Pokelinux lifecycle authority and Messages projection
After=local-fs.target
[Service]
Type=simple
ExecStart=/usr/libexec/pokelinux/messages-service /run/pokelinux/messages /var/lib/pokelinux/policy /etc/pokelinux/messages-profile.json /usr/libexec/pokelinux/lifecycle-launcher /var/lib/pokelinux/receipts /var/lib/pokelinux/inbox
ExecStop=/usr/libexec/pokelinux/messages-stop /run/pokelinux/messages/admin.sock
RuntimeDirectory=pokelinux/messages
RuntimeDirectoryMode=0755
StateDirectory=pokelinux/policy pokelinux/receipts pokelinux/inbox
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_KILL
TasksMax=96
MemoryMax=512M
KillMode=control-group
TimeoutStopSec=5
Restart=no
[Install]
WantedBy=multi-user.target
