if(NOT DEFINED ELF OR NOT EXISTS "${ELF}")
 message(FATAL_ERROR "ELF must name an existing compiled executable")
endif()
if(NOT DEFINED READELF OR NOT EXISTS "${READELF}")
 message(FATAL_ERROR "READELF must name the target readelf tool")
endif()
file(READ "${ELF}" magic LIMIT 4 HEX)
if(NOT magic STREQUAL "7f454c46")
 message(FATAL_ERROR "Not an ELF executable: ${ELF}")
endif()
execute_process(COMMAND "${READELF}" --relocs --wide "${ELF}"
 RESULT_VARIABLE result OUTPUT_VARIABLE relocations ERROR_VARIABLE error)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "readelf failed for ${ELF}: ${error}")
endif()
string(REGEX MATCHALL "[^\n]*R_[A-Za-z0-9_]+_COPY[^\n]*" copies "${relocations}")
if(copies)
 string(REPLACE ";" "\n" copies "${copies}")
 message(FATAL_ERROR "Copy relocations are forbidden in ${ELF}:\n${copies}")
endif()
message(STATUS "No copy relocations in ${ELF}")
