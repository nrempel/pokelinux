        "ev_9e884fa814e9cf0bed193647e432f55f4288ea0f8618f9fef6dd016dbb6ea2a8",
        "ev_56c759bc8e36f5d89384fc7dff8afbfbbaa1914690b93b61f5002f0720a0a475"
      ],
      "confidence": "high for declared version; factory interface-hash equality unresolved"
    },
    {
      "id": "request-acceptance",
      "claim": "Request wrapper removes caches, converts requests, delegates to GoogleCameraHal::ProcessCaptureRequest, sets processed-count output and maps status. Capture remains asynchronous. Android17 NDK dispatcher and proxy skip return/out values on error, so a failed remote batch cannot safely expose or imply the locally set partial count. Add submission-uncertain ownership until callbacks/drain/reset reconcile.",
      "evidence_ids": [
        "ev_43554d82da5544c1395735c7933b5f1463a0eb0ee513971ff2706cfa901d216e"
      ],
      "confidence": "high static call and generator evidence; factory dispatcher execution unverified"
    },
    {
      "id": "buffers-fences",
      "claim": "Track first-submit NativeHandle+bufferId, subsequent cached bufferId, cache removal and frame/stream lookup. Acquire fence gates HAL access; release fence gates client access and reuse even on failed buffers. Callback return can precede fence signalling. Factory request-buffer callback calls dupFromAidl and GraphicBufferMapper::importBufferNoValidate, then deletes temporary handle envelopes. Distinguish envelope deletion, fd close, allocator release and completed DMA.",
      "evidence_ids": [
        "ev_b01c281da447f89d220e32884c3f3c60884630d65434cec8579d6187fce8bda0",
        "ev_eb32b2efab324f351f6eeccf3103a60fd81a644178e6c79870a22c0fa36623e3",
        "ev_e5c4dcc83e87638eecfceee1bbacb9a8f107f783b02e4984c0dc0a5217549b3c"
      ],
      "confidence": "high public obligations and call evidence; full factory allocator semantics unresolved"
    },
    {
      "id": "flush-close",
      "claim": "flush delegates to Google HAL Flush. Factory signalStreamFlush is a 40-byte success stub whose only callee is AStatus_newOk; its oneway acknowledgement proves no drainage. close has no direct Flush callee; public wrapper clears underlying unique_ptr and returns OK. Actual destructor cleanup, in-flight DMA safety and reopen behavior remain unverified.",
      "evidence_ids": [
        "ev_dbabb34cf120b9ec4f17f2f0003c1e44604e9205f875240026424fd5279409b1",
        "ev_54d3bd2fd750463ce82ad7aba0b6ec29a2f9201d8173d0474f1d83e3b78284ac",
        "ev_2074fa5c054a3c38d255175da5f414c3a87e23c263454efa0aebfff25fcdef21"
      ],
      "confidence": "high wrapper evidence; dependency cleanup unknown"
    },
