  "camera_static_findings": [
    {
      "id": "camera-abi",
      "claim": "The @2.7 executable/init name is legacy naming. Factory declares AIDL provider4; DT_NEEDED independently confirms device-V4-ndk/provider-V4-ndk. Exact frozen public v4 reference is recovered from Android17 release tag. Missing main-tree v4 was branch-specific.",
