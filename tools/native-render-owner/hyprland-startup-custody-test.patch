+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#endif
+#include "StartupTestTrace.hpp"
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+#include <array>
+#include <cerrno>
+#include <climits>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <limits>
+#include <sys/socket.h>
+#include <sys/syscall.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+namespace Pokelinux::StartupCustodyTest {
+namespace {
+thread_local CStartupTestTrace* activeTrace = nullptr;
+constexpr size_t MAX_EVENT_BYTES = 96;
+
+bool expectedRootPID(const char* text, pid_t& result) noexcept {
+    if (!text)
+        return false;
+    const size_t length = ::strnlen(text, 11);
+    if (!length || length > 10 || text[0] == '0')
+        return false;
+    uint32_t value = 0;
+    for (size_t i = 0; i < length; ++i) {
+        if (text[i] < '0' || text[i] > '9')
+            return false;
+        const uint32_t digit = static_cast<uint32_t>(text[i] - '0');
+        if (value > (static_cast<uint32_t>(INT_MAX) - digit) / 10)
+            return false;
+        value = value * 10 + digit;
+    }
+    if (!value)
+        return false;
+    result = static_cast<pid_t>(value);
+    return true;
+}
+
+bool selectedCase(const char* text, uint32_t& result) noexcept {
+    if (!text || ::strnlen(text, 2) != 1 || (text[0] != '1' && text[0] != '2'))
+        return false;
+    result = static_cast<uint32_t>(text[0] - '0');
+    return true;
+}
+
+bool escapeEvent(const char* event, char* escaped) noexcept {
+    if (!event)
+        return false;
+    const size_t length = ::strnlen(event, MAX_EVENT_BYTES + 1);
+    if (!length || length > MAX_EVENT_BYTES)
+        return false;
+    size_t used = 0;
+    for (size_t i = 0; i < length; ++i) {
+        const unsigned char byte = static_cast<unsigned char>(event[i]);
+        if (byte < 0x20 || byte > 0x7e)
+            return false;
+        if (byte == '"' || byte == '\\')
+            escaped[used++] = '\\';
+        escaped[used++] = static_cast<char>(byte);
+    }
+    escaped[used] = '\0';
+    return true;
+}
+} // namespace
+
+uint64_t CStartupTestTrace::actualTID() noexcept {
+    const long value = ::syscall(SYS_gettid);
+    return value > 0 ? static_cast<uint64_t>(value) : 0;
+}
+
+STraceStamp CStartupTestTrace::stamp() noexcept {
+    STraceStamp result{};
+    result.tid = actualTID();
+    if (!result.tid)
+        return result;
+    timespec value{};
+    if (::clock_gettime(CLOCK_BOOTTIME, &value) != 0)
+        return result;
+    if (value.tv_sec < 0 || value.tv_nsec < 0 || value.tv_nsec >= 1'000'000'000L ||
+        static_cast<uint64_t>(value.tv_sec) >
+            (std::numeric_limits<uint64_t>::max() - static_cast<uint64_t>(value.tv_nsec)) / 1'000'000'000ULL) {
+        errno = ERANGE;
+        return result;
+    }
+    result.boottimeNs = static_cast<uint64_t>(value.tv_sec) * 1'000'000'000ULL + static_cast<uint64_t>(value.tv_nsec);
+    result.valid = result.boottimeNs != 0;
+    if (!result.valid)
+        errno = ERANGE;
+    return result;
+}
+
+bool CStartupTestTrace::fail(int error) noexcept {
+    m_state = EState::FAILED;
+    if (!m_error)
+        m_error = error ? error : EIO;
+    if (activeTrace == this)
+        activeTrace = nullptr;
+    if (m_fd >= 0) {
+        const int fd = m_fd;
+        m_fd = -1;
+        ::close(fd);
+    }
+    // close must not erase the first failure, including connect's EAGAIN.
+    errno = m_error;
+    return false;
+}
+
+bool CStartupTestTrace::open(uint32_t role) noexcept {
+    if (m_state != EState::EMPTY)
+        return fail(EALREADY);
+    m_state = EState::FAILED;
+    m_ownerTid = actualTID();
+    if (!m_ownerTid)
+        return fail(errno ? errno : EIO);
+    if ((role != 1 && role != 2) || activeTrace)
+        return fail(role != 1 && role != 2 ? EINVAL : EBUSY);
+    m_role = role;
+
+    // Only these fixed fixture variables are read. No caller-selected env names.
+    const char* path = std::getenv("POKELINUX_STARTUP_TRACE_SOCKET");
+    const char* rootPIDText = std::getenv("POKELINUX_STARTUP_TRACE_ROOT_PID");
+    const char* caseText = std::getenv("POKELINUX_STARTUP_CUSTODY_CASE");
+    sockaddr_un address{};
+    pid_t rootPID = 0;
+    if (!path || !expectedRootPID(rootPIDText, rootPID) || !selectedCase(caseText, m_case))
+        return fail(EINVAL);
+    const size_t pathLength = ::strnlen(path, sizeof(address.sun_path));
+    if (pathLength < 2 || pathLength >= sizeof(address.sun_path) || path[0] != '/')
+        return fail(EINVAL);
+    address.sun_family = AF_UNIX;
+    std::memcpy(address.sun_path, path, pathLength + 1);
+
+    m_fd = ::socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+    if (m_fd < 0)
+        return fail(errno);
+    const socklen_t addressLength = static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) + pathLength + 1);
+    if (::connect(m_fd, reinterpret_cast<const sockaddr*>(&address), addressLength) != 0)
+        return fail(errno); // Includes EAGAIN/EINPROGRESS/EINTR: never retry/wait.
+    ucred peer{};
+    socklen_t peerLength = sizeof(peer);
+    if (::getsockopt(m_fd, SOL_SOCKET, SO_PEERCRED, &peer, &peerLength) != 0)
+        return fail(errno);
+    if (peerLength != sizeof(peer) || peer.pid != rootPID || peer.uid != 0 || peer.gid != 0)
+        return fail(EPERM);
+
+    m_state = EState::OPEN;
+    activeTrace = this; // Only authenticated successful open installs the TLS view.
+    return true;
+}
+
+bool CStartupTestTrace::okay() const noexcept {
+    return m_state == EState::OPEN && m_fd >= 0 && m_ownerTid && m_ownerTid == actualTID();
+}
+
+uint32_t CStartupTestTrace::caseSelection() const noexcept {
+    return m_ownerTid && m_ownerTid == actualTID() ? m_case : 0;
+}
+
+int CStartupTestTrace::failureErrno() const noexcept {
+    if (m_ownerTid && m_ownerTid != actualTID())
+        return EXDEV;
+    return m_error;
+}
+
+CStartupTestTrace* CStartupTestTrace::current() noexcept {
+    if (activeTrace && !activeTrace->okay())
+        activeTrace = nullptr;
+    return activeTrace;
+}
+
+bool CStartupTestTrace::emit(const char* event, std::string_view trustedFragment) noexcept {
+    if (!okay())
+        return fail(m_ownerTid && m_ownerTid != actualTID() ? EXDEV : ENOTCONN);
+    const STraceStamp observed = stamp();
+    if (!observed.valid)
+        return fail(errno ? errno : EIO);
+    return emitStamped(event, observed, trustedFragment);
+}
+
+bool CStartupTestTrace::emitStamped(const char* event, STraceStamp observed, std::string_view trustedFragment) noexcept {
+    if (!okay())
+        return fail(m_ownerTid && m_ownerTid != actualTID() ? EXDEV : ENOTCONN);
+    if (!observed.valid || !observed.boottimeNs || observed.tid != m_ownerTid)
+        return fail(EINVAL);
+    if (m_records >= MAX_RECORDS || trustedFragment.size() > MAX_PACKET_BYTES)
+        return fail(EMSGSIZE);
+    std::array<char, MAX_EVENT_BYTES * 2 + 1> escaped{};
+    if (!escapeEvent(event, escaped.data()))
+        return fail(EINVAL);
+    if (!trustedFragment.empty() && trustedFragment.front() != ',')
+        return fail(EINVAL);
+
+    std::array<char, MAX_PACKET_BYTES> packet{};
+    const int prefix = std::snprintf(packet.data(), packet.size(),
+        "{\"schema\":1,\"run\":1,\"event\":\"%s\",\"tid\":%llu,\"observed_boottime_ns\":%llu,\"sequence\":%u,\"role\":%u",
+        escaped.data(), static_cast<unsigned long long>(observed.tid),
+        static_cast<unsigned long long>(observed.boottimeNs), m_records + 1, m_role);
+    if (prefix < 0)
+        return fail(EIO);
+    const size_t prefixBytes = static_cast<size_t>(prefix);
+    if (prefixBytes >= packet.size() || trustedFragment.size() > packet.size() - prefixBytes - 1)
+        return fail(EMSGSIZE);
+    const size_t packetBytes = prefixBytes + trustedFragment.size() + 1;
+    if (m_bytes > MAX_TOTAL_BYTES || packetBytes > MAX_TOTAL_BYTES - m_bytes)
+        return fail(EMSGSIZE);
+    if (!trustedFragment.empty())
+        std::memcpy(packet.data() + prefixBytes, trustedFragment.data(), trustedFragment.size());
+    packet[packetBytes - 1] = '}';
+
+    // Exactly one send, no sendmsg/ancillary capabilities, blocking or retries.
+    const ssize_t sent = ::send(m_fd, packet.data(), packetBytes, MSG_NOSIGNAL | MSG_DONTWAIT);
+    if (sent < 0)
+        return fail(errno);
+    if (static_cast<size_t>(sent) != packetBytes)
+        return fail(EIO);
+    ++m_records;
+    m_bytes += packetBytes;
+    return true;
+}
+
+CStartupTestTrace::~CStartupTestTrace() noexcept {
+    // An opened object cannot be moved to another thread, which would leave its
+    // owner-thread TLS pointer dangling. There is no supported concurrent access.
+    if (m_ownerTid && m_ownerTid != actualTID())
+        std::terminate();
+    if (activeTrace == this)
+        activeTrace = nullptr;
+    if (m_fd >= 0) {
+        const int savedErrno = errno;
+        ::close(m_fd);
+        errno = savedErrno;
+    }
+}
+} // namespace Pokelinux::StartupCustodyTest
+#endif
diff --git a/src/render/StartupTestTrace.hpp b/src/render/StartupTestTrace.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..a7c9fdca0bd837046e7b081f16194af3593ce6a8
--- /dev/null
+++ b/src/render/StartupTestTrace.hpp
@@ -0,0 +1,63 @@
+#pragma once
+// Fixture-only, main-linked transport. Ordinary builds expose no declarations.
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+namespace Pokelinux::StartupCustodyTest {
+struct STraceStamp {
+    uint64_t boottimeNs = 0;
+    uint64_t tid = 0;
+    bool valid = false;
+};
+
+class CStartupTestTrace final {
+  public:
+    // CPU-empty: no environment read, timestamp, descriptor or TLS installation.
+    CStartupTestTrace() noexcept = default;
+    ~CStartupTestTrace() noexcept;
+    CStartupTestTrace(const CStartupTestTrace&) = delete;
+    CStartupTestTrace& operator=(const CStartupTestTrace&) = delete;
+    CStartupTestTrace(CStartupTestTrace&&) = delete;
+    CStartupTestTrace& operator=(CStartupTestTrace&&) = delete;
+
+    // Explicitly call at main begin (role 1) or worker bootstrap (role 2), never
+    // from Nativecreate. Exactly one attempt per instance, with no waiting/retry.
+    // Successful open installs this instance as this thread's trace context.
+    bool open(uint32_t role) noexcept;
+    bool okay() const noexcept;
+    uint32_t caseSelection() const noexcept;
+    int failureErrno() const noexcept;
+
+    // Trusted caller-only fragment: comma-prefixed JSON members, no outer braces
+    // and no duplicate envelope keys. Numeric/bool/arrays are permitted. Never
+    // pass external data, addresses, native handles, FD numbers or capabilities.
+    bool emit(const char* event, std::string_view trustedFragment = {}) noexcept;
+    // Preserve an actual earlier same-thread stamp, e.g. Nativecreate's CPU-only
+    // observation, emitted only after the worker explicitly opens at bootstrap.
+    bool emitStamped(const char* event, STraceStamp actualSavedStamp,
+                     std::string_view trustedFragment = {}) noexcept;
+
+    static STraceStamp stamp() noexcept;
+    static uint64_t actualTID() noexcept;
+    static CStartupTestTrace* current() noexcept;
+
+    static constexpr size_t MAX_PACKET_BYTES = 8192;
+    static constexpr uint32_t MAX_RECORDS = 64;
+    static constexpr uint64_t MAX_TOTAL_BYTES = 64 * 1024;
+
+  private:
+    enum class EState : uint8_t { EMPTY, OPEN, FAILED };
+    bool fail(int error) noexcept;
+    int m_fd = -1;
+    EState m_state = EState::EMPTY;
+    uint32_t m_case = 0;
+    uint32_t m_role = 0;
+    uint32_t m_records = 0;
+    uint64_t m_bytes = 0;
+    uint64_t m_ownerTid = 0;
+    int m_error = 0;
+};
+} // namespace Pokelinux::StartupCustodyTest
+#endif
diff --git a/src/render/custody-consumer.inc b/src/render/custody-consumer.inc
new file mode 100644
index 0000000000000000000000000000000000000000..3f27c91d71ad3b7354bd57610cba408334a466f1
--- /dev/null
+++ b/src/render/custody-consumer.inc
@@ -0,0 +1,57 @@
+// Frozen source-only worker consumer for the agreed new API. No fallback.
+// This state MUST be a retained actual NativeOwner member, never an automatic
+// temporary. Root's narrowly compiled native hooks supply the separate weak-
+// identity/destructor-entry oracle; no destructor or graph is mocked here.
+#include <aquamarine/backend/Backend.hpp>
+#include <aquamarine/backend/Session.hpp>
+#include <hyprutils/memory/SharedPtr.hpp>
+#include <cstdint>
+#include <type_traits>
+
+namespace Pokelinux::StartupCustodyTest {
+using Hyprutils::Memory::CSharedPointer;
+using Aquamarine::CBackend;
+using Aquamarine::CSession;
+using Aquamarine::SBackendOptions;
+using HolderFactory = CSharedPointer<CBackend> (*)(const SBackendOptions&, CSharedPointer<CSession>);
+using Initialize = bool (CBackend::*)();
+static_assert(std::is_same_v<decltype(&CBackend::createRenderSessionHolder), HolderFactory>);
+static_assert(std::is_same_v<decltype(&CBackend::initializeRenderSession), Initialize>);
+
+enum class Case : uint32_t { AFTER_REAL_RESOURCE_SCAN=1, AFTER_REAL_IMPLEMENTATION_START=2 };
+struct RetainedCase {
+    CSharedPointer<CBackend> backend;
+    bool entered=false, initializeCalled=false, initializeReturned=false;
+    bool startCalled=false, startReturned=false, unexpectedException=false;
+    bool expectedInjectedFailureReturned=false;
+};
+// Root installs one worker-local test hook scope before this call. The scope
+// holds only weak native identities, never strong ownership masking failure.
+// The mirror and its real FD capabilities are already retained on this worker.
+void exercise(RetainedCase& state, Case which, const SBackendOptions& options,
+              CSharedPointer<CSession> mirror) noexcept {
+    if(state.entered || state.backend) {state.unexpectedException=true;return;}
+    state.entered=true;
+    try {
+        // The agreed holder constructor is CPU-only. Store it BEFORE native init.
+        state.backend=CBackend::createRenderSessionHolder(options,mirror);
+        if(!state.backend) return; // setup/factory failure, not target custody RED
+        state.initializeCalled=true;
+        state.initializeReturned=state.backend->initializeRenderSession();
+        if(which==Case::AFTER_REAL_RESOURCE_SCAN) {
+            // Hook deliberately uses the real child failure/continue branch.
+            state.expectedInjectedFailureReturned=!state.initializeReturned;
+            return; // no reset/drop/retry/alternate backend
+        }
+        if(which!=Case::AFTER_REAL_IMPLEMENTATION_START || !state.initializeReturned) return;
+        state.startCalled=true;
+        state.startReturned=state.backend->start();
+        // Hook observes real impl.start() success then injects effective failure.
+        state.expectedInjectedFailureReturned=!state.startReturned;
+    } catch(...) {
+        // Catch C++ exceptions before Rust. Any partial native custody stays in
+        // retained state; actual child destructor hooks reveal early unwind.
+        state.unexpectedException=true;
+    }
+}
+} // namespace Pokelinux::StartupCustodyTest
