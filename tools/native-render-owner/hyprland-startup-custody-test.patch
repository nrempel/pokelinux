+            if (terminal || broker->transportFailed() || !broker->markRenderEventAdmitted(batch[i].metadata.session_sequence))
+                throw std::runtime_error("initial prefix admission failed");
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
