+// Startup uses a bounded nonblocking request/reply transport. The client
+// half-closes its write side to delimit the exact raw request; no flags/batch or
+// partial-prefix dispatch. Slow clients never hold the actual main loop.
+struct CHyprCtl::SEarlyConnection {
+    CHyprCtl* owner;
+    CFileDescriptor socket, timer;
+    wl_event_source* socketSource = nullptr;
+    wl_event_source* timerSource = nullptr;
+    std::string request, reply;
+    size_t sent = 0;
+    bool responding = false;
+    uint64_t cutoffNs = 0;
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+    uint64_t acceptedNs = 0, requestEOFNs = 0, dispatchCheckedNs = 0, lastSendCheckedNs = 0;
+    mutable uint64_t lastCutoffCheckNs = 0;
+    uint32_t sendAttempts = 0, sendChecks = 0;
+    bool listenerNonblocking = false, acceptedNonblocking = false;
+    void traceWire() {
+        auto* trace = Pokelinux::StartupCustodyTest::CStartupTestTrace::current();
+        if (!trace) return; // Missing authenticated records cannot qualify a test.
+        constexpr char digits[] = "0123456789abcdef";
+        std::string hex;
+        hex.reserve(request.size() * 2);
+        for (const unsigned char value : request) { hex += digits[value >> 4]; hex += digits[value & 15]; }
+        trace->emit("CONTROL_WIRE", std::format(
+            R"(,"request_utf8_hex":"{}","accepted_at_ns":{},"original_client_until_ns":{},"server_request_EOF_at_ns":{},"dispatch_deadline_checked_at_ns":{},"last_send_deadline_checked_at_ns":{},"send_attempt_count":{},"send_deadline_check_count":{},"listener_nonblocking":{},"accepted_socket_nonblocking":{},"read_and_write_nonblocking":true,"response_bytes":{})",
+            hex, acceptedNs, cutoffNs, requestEOFNs, dispatchCheckedNs, lastSendCheckedNs, sendAttempts, sendChecks,
+            listenerNonblocking ? "true" : "false", acceptedNonblocking ? "true" : "false", reply.size()));
+    }
+#endif
+
+    bool beforeCutoff() const noexcept {
+        timespec now{};
+        if (!cutoffNs || clock_gettime(CLOCK_BOOTTIME, &now) != 0 || now.tv_sec < 0) return false;
+        const auto checked = uint64_t(now.tv_sec) * 1'000'000'000ULL + uint64_t(now.tv_nsec);
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+        lastCutoffCheckNs = checked;
+#endif
+        return checked < cutoffNs;
+    }
+
+    explicit SEarlyConnection(CHyprCtl* value) : owner(value) {}
+    ~SEarlyConnection() { finish(); }
+    void finish() noexcept {
+        if (socketSource) wl_event_source_remove(socketSource);
+        if (timerSource) wl_event_source_remove(timerSource);
+        socketSource = timerSource = nullptr;
+        socket = CFileDescriptor{};
+        timer = CFileDescriptor{};
+        request.clear(); reply.clear(); sent = 0; responding = false; cutoffNs = 0;
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+        acceptedNs = requestEOFNs = dispatchCheckedNs = lastSendCheckedNs = lastCutoffCheckNs = 0;
+        sendAttempts = sendChecks = 0;
+        listenerNonblocking = acceptedNonblocking = false;
+#endif
+    }
+    static int expired(int, uint32_t, void* value) noexcept {
+        static_cast<SEarlyConnection*>(value)->finish();
+        return 0;
+    }
+    static int tick(int, uint32_t mask, void* value) noexcept {
+        auto& self = *static_cast<SEarlyConnection*>(value);
+        try {
+            if (!self.beforeCutoff() || (mask & WL_EVENT_ERROR)) { self.finish(); return 0; }
+            if (!self.responding) {
+                // At most 65 bytes and two recv calls in a dispatch. EOF is the
+                // framing boundary; a client never chooses how long main waits.
+                std::array<char, 65> bytes{};
+                for (unsigned budget = 0; budget < 2; ++budget) {
+                    const auto got = recv(self.socket.get(), bytes.data(), bytes.size(), MSG_DONTWAIT);
+                    if (got < 0) {
+                        if (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR) return 0;
+                        self.finish(); return 0;
+                    }
+                    if (got == 0) {
+                        if (!self.beforeCutoff()) { self.finish(); return 0; }
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+                        self.requestEOFNs = self.lastCutoffCheckNs;
+                        self.dispatchCheckedNs = self.lastCutoffCheckNs;
+#endif
+                        self.reply = self.owner->getReply(self.request);
+                        if (self.reply.size() > 2048) { self.finish(); return 0; }
+                        self.responding = true;
+                        break;
+                    }
+                    self.request.append(bytes.data(), size_t(got));
+                    if (self.request.size() > 64) { self.finish(); return 0; }
+                }
+                if (!self.responding) return 0;
+            }
+            if (!self.beforeCutoff()) { self.finish(); return 0; }
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+            self.lastSendCheckedNs = self.lastCutoffCheckNs;
+            ++self.sendChecks;
+            ++self.sendAttempts;
+#endif
+            const auto put = send(self.socket.get(), self.reply.data() + self.sent, self.reply.size() - self.sent, MSG_DONTWAIT | MSG_NOSIGNAL);
+            if (put < 0) {
+                if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) { self.finish(); return 0; }
+            } else self.sent += size_t(put);
+            if (self.sent == self.reply.size()) {
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+                self.traceWire();
+#endif
+                self.finish(); return 0;
+            }
+            if (wl_event_source_fd_update(self.socketSource, WL_EVENT_WRITABLE) < 0) self.finish();
+        } catch (...) { self.finish(); }
+        return 0;
+    }
+    bool start(CFileDescriptor owned, uint64_t acceptedAtNs) {
+        socket = std::move(owned);
+        const auto flags = fcntl(socket.get(), F_GETFL);
+        if (flags < 0 || fcntl(socket.get(), F_SETFL, flags | O_NONBLOCK) < 0) return false;
+        timer = CFileDescriptor{timerfd_create(CLOCK_BOOTTIME, TFD_CLOEXEC | TFD_NONBLOCK)};
+        if (!timer.isValid()) return false;
+        if (!acceptedAtNs || acceptedAtNs > UINT64_MAX - 2'000'000'000ULL) return false;
+        cutoffNs = acceptedAtNs + 2'000'000'000ULL;
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+        acceptedNs = acceptedAtNs;
+        const int acceptedFlags = fcntl(socket.get(), F_GETFL);
+        const int listenerFlags = fcntl(owner->m_socketFD.get(), F_GETFL);
+        acceptedNonblocking = acceptedFlags >= 0 && (acceptedFlags & O_NONBLOCK);
+        listenerNonblocking = listenerFlags >= 0 && (listenerFlags & O_NONBLOCK);
+#endif
+        if (!beforeCutoff()) return false;
+        itimerspec cutoff{};
+        cutoff.it_value.tv_sec = time_t(cutoffNs / 1'000'000'000ULL);
+        cutoff.it_value.tv_nsec = long(cutoffNs % 1'000'000'000ULL);
+        if (timerfd_settime(timer.get(), TFD_TIMER_ABSTIME, &cutoff, nullptr) < 0) return false;
+        const auto loop = g_pCompositor->m_wlEventLoop;
+        socketSource = wl_event_loop_add_fd(loop, socket.get(), WL_EVENT_READABLE, tick, this);
+        timerSource = wl_event_loop_add_fd(loop, timer.get(), WL_EVENT_READABLE, expired, this);
+        return socketSource && timerSource;
+    }
+};
+
+void CHyprCtl::acceptStartupConnection(int ownedFD, uint64_t acceptedAtNs) noexcept {
+    CFileDescriptor accepted{ownedFD};
+    try {
+        // Native Linux target; only this user or the root-owned fixture/admin
+        // may issue startup control through the private instance socket.
+        ucred peer{};
+        socklen_t length = sizeof(peer);
+        if (getsockopt(accepted.get(), SOL_SOCKET, SO_PEERCRED, &peer, &length) != 0 || length != sizeof(peer) ||
+            (peer.uid != getuid() && peer.uid != 0)) return;
+        for (auto& slot : m_earlyConnections) {
+            if (!slot) slot = std::make_unique<SEarlyConnection>(this);
+            if (slot->socket.isValid()) continue;
+            if (!slot->start(std::move(accepted), acceptedAtNs)) slot->finish();
+            return;
+        }
+    } catch (...) { /* accepted connection remains owned on every refusal */ }
+}
