+        timer.source = wl_event_loop_add_fd(loop, timer.fd, WL_EVENT_READABLE, rustTick, &timer);
+        if (!completion.source || !timer.source) throw std::runtime_error("Rust watch registration failed");
+        syncBrokerWatches();
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+        traceRequired(trace, "MAIN_WATCHES_REGISTERED", std::format(
+            R"(,"broker_sources_control_only":true,"completion_borrowed":true,"startup_borrowed":true,"completion_fd":{},"startup_fd":{})",
+            completion.fd, timer.fd));
+#endif
+        // Input onReady is deferred until real CPU/input managers subscribe.
+        // No native output, broker pointer or rendering FD crosses to main.
+        observe();
+    }
+    std::string reply(std::string_view request) {
+        if (thread != std::this_thread::get_id()) throw std::runtime_error("wrong startup control thread");
+        if (request != "owner-startup snapshot" && request != "owner-startup stop") return "startup request unavailable";
