+struct COwnedBackendStartup::SControl {
+    const std::thread::id thread = std::this_thread::get_id();
+    wl_event_loop* loop;
+    Pointer<CSession> broker;
+    PrExecutor* executor = nullptr;
+    PrBootstrap* pack = nullptr;
+    PrDiscoveryV1 discovery{};
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+    TestTrace trace;
+#endif
+    uint64_t generation = 0, startupNotAfter = 0;
+    bool began = false, terminal = false, failed = false, backendReady = false;
+    int32_t firstError = PR_EXECUTOR_OK;
+    struct SWatch {
+        SControl* control = nullptr;
+        wl_event_source* source = nullptr;
+        Pointer<SPollFD> brokerPoll;
+        int fd = -1;
+    } completion, timer;
+    std::array<SWatch, PR_EXECUTOR_MAX_SOURCES> brokerWatches{};
+
+    explicit SControl(wl_event_loop* value) : loop(value) {}
+    ~SControl() {
+        // No blocking Drop, detach, graph destruction or lease acknowledgment
+        // can turn an alive worker into a successful shutdown.
+        if (executor) std::terminate();
+        if (pack) pr_bootstrap_release(pack);
+        for (auto& watch : brokerWatches) if (watch.source) wl_event_source_remove(watch.source);
+    }
+    void fail(int32_t error) noexcept {
+        failed = true;
+        if (!firstError) firstError = error;
+        stop();
+    }
+    int32_t stop() noexcept {
+        terminal = true;
+        backendReady = false;
+        const auto code = executor ? pr_executor_stop(executor) : PR_EXECUTOR_EMPTY;
+        if (executor && code != PR_EXECUTOR_OK) { failed = true; if (!firstError) firstError = code; }
+        return code;
+    }
+    static uint32_t revoke(void* opaque, uint64_t session, uint32_t) noexcept {
+        auto& control = *static_cast<SControl*>(opaque);
+        if (control.thread != std::this_thread::get_id()) return AQ_REVOKE_UNAVAILABLE;
+        control.terminal = true; // Authentic preworker latch, including ctor callbacks.
+        control.backendReady = false;
+        if (!control.executor || session != control.generation)
+            return AQ_REVOKE_UNAVAILABLE;
+        const auto code = pr_executor_stop(control.executor);
+        if (code != PR_EXECUTOR_OK) { control.failed = true; control.firstError = code; return AQ_REVOKE_UNAVAILABLE; }
+        return AQ_REVOKED;
+    }
+    bool initialTransportHealthy() const {
+        return !terminal && broker && !broker->transportFailed() && !broker->peekPendingRenderEvent();
+    }
+    static int brokerTick(int, uint32_t mask, void* opaque) noexcept {
+        auto& watch = *static_cast<SWatch*>(opaque);
+        auto& control = *watch.control;
+        try {
+            if (mask & (WL_EVENT_ERROR | WL_EVENT_HANGUP)) { control.fail(PR_EXECUTOR_PROTOCOL); return 0; }
+            if (watch.brokerPoll) watch.brokerPoll->onSignal();
+            // There is no ordered live ingress yet. EVERY suffix, including
+            // ADD, ENUM, ACTIVE, REMOVE, CHANGE and SHUTDOWN, fails closed. It
+            // stays queued and the original service lease remains retained.
+            if (control.broker->transportFailed() || control.broker->peekPendingRenderEvent()) control.stop();
+            control.syncBrokerWatches();
+        } catch (...) { control.fail(PR_EXECUTOR_NATIVE); }
+        return 0;
+    }
+    void syncBrokerWatches() {
+        const auto polls = broker->pollFDs();
+        if (polls.size() > brokerWatches.size()) throw std::runtime_error("broker poll capacity");
+        for (auto& watch : brokerWatches) {
+            const bool retained = watch.brokerPoll && std::ranges::any_of(polls, [&](const auto& p) { return p && p == watch.brokerPoll && p->fd == watch.fd; });
+            if (!retained) {
+                if (watch.source) wl_event_source_remove(watch.source);
+                watch = {};
+            }
+        }
+        for (const auto& poll : polls) {
+            if (!poll || poll->fd < 0 || !poll->onSignal) throw std::runtime_error("invalid broker poll source");
+            if (std::ranges::any_of(brokerWatches, [&](const auto& w) { return w.source && w.fd == poll->fd; })) continue;
+            auto slot = std::ranges::find_if(brokerWatches, [](const auto& w) { return !w.source; });
+            if (slot == brokerWatches.end()) throw std::runtime_error("broker source capacity");
+            slot->control = this;
+            slot->brokerPoll = poll;
+            slot->fd = poll->fd;
+            slot->source = wl_event_loop_add_fd(loop, poll->fd, WL_EVENT_READABLE, brokerTick, &*slot);
+            if (!slot->source) throw std::runtime_error("broker watch registration");
+        }
+    }
+    static int rustTick(int, uint32_t mask, void* opaque) noexcept {
+        auto& control = *static_cast<SWatch*>(opaque)->control;
+        if (mask & (WL_EVENT_ERROR | WL_EVENT_HANGUP)) control.fail(PR_EXECUTOR_WAKE);
+        control.observe();
+        // A bounded actual completion dequeue clears/rearms the Rust eventfd;
+        // the BOOTTIME timer is observed through the real executor API above.
+        PrCompletionV1 record{};
+        const auto code = pr_executor_next_completion_v1(control.executor, &record);
+        if (code == PR_EXECUTOR_OK || (code != PR_EXECUTOR_EMPTY && code != PR_EXECUTOR_BUSY))
+            control.fail(code == PR_EXECUTOR_OK ? PR_EXECUTOR_PROTOCOL : code); // No frame has been admitted.
+        return 0;
+    }
+    void observe() noexcept {
+        if (!executor) return;
