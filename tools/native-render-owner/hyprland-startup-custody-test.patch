+PrSessionRenderEventV1 copyEvent(const SSessionRenderEvent& source) {
+    PrSessionRenderEventV1 out{};
+    out.version = source.version;
+    out.event_type = source.type;
+    out.session_sequence = source.session_sequence;
+    out.session_generation = source.session_generation;
+    out.device_lease_id = source.device_lease_id;
+    out.device_generation = source.device_generation;
+    out.rdev = source.rdev;
+    out.active = source.active;
+    out.vt = source.vt;
+    out.change_type = source.change_type;
+    out.connector_id = source.connector_id;
+    out.prop_id = source.prop_id;
+    out.boot_vga = source.boot_vga;
+    std::copy(std::begin(source.reserved), std::end(source.reserved), out.reserved);
+    std::memcpy(out.seat_name, source.seat_name, sizeof(out.seat_name));
+    std::memcpy(out.device_path, source.device_path, sizeof(out.device_path));
+    return out;
+}
