+        began = true;
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+        if (!trace.open(1)) throw std::runtime_error("startup control trace unavailable");
+#endif
+        generation = boottime();
+        constexpr uint64_t STARTUP_NS = 20'000'000'000ULL;
+        if (!generation || generation > std::numeric_limits<uint64_t>::max() - STARTUP_NS) throw std::runtime_error("startup clock range");
+        startupNotAfter = generation + STARTUP_NS; // Set BEFORE fallible broker construction.
