+                if (fd >= 0) pendingClosed = pendingClosed && closedFD(fd);
+        traceRequired(trace, "BROKER_PREFIX_MARKED", std::format(
+            R"(,"enter_ns":{},"return_ns":{},"sequences":{},"pending_duplicates_closed":{},"original_service_lease_retained":{},"post_prefix_suffix_count":{},"transport_failed":{},"preworker_revocation_latched":{})",
