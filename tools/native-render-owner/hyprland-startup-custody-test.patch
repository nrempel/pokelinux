+#pragma once
+#ifndef POKELINUX_STARTUP_CUSTODY_TEST
+#error "StartupCustodyProbe is main-linked test infrastructure only"
+#endif
+#include <aquamarine/backend/Backend.hpp>
+#include <aquamarine/backend/DisplayAttempt.hpp>
+#include <aquamarine/backend/StartupCustodyTest.hpp>
+#include <memory>
+#include <string_view>
+
+namespace Pokelinux::StartupCustodyTest {
+// UNQUALIFIED is setup/unexpected metadata/transport failure, never target RED.
+enum class Outcome : uint32_t { UNQUALIFIED = 0, CUSTODY_LOST = 1, RETAINED = 2 };
+class CStartupCustodyProbe final : public Aquamarine::StartupCustodyTest::IProbe {
+  public:
+    using SelectedCase = Aquamarine::StartupCustodyTest::eCase;
+    using RecordSink = bool (*)(void*, const char* event, Aquamarine::StartupCustodyTest::SProbeStamp actualStamp,
+                                std::string_view trustedCommaPrefixedFragment) noexcept;
+    // Construct as an SNativeOwner member ON the Rust worker, before acquisition.
+    CStartupCustodyProbe();
+    ~CStartupCustodyProbe() noexcept override;
+    CStartupCustodyProbe(const CStartupCustodyProbe&) = delete;
+    CStartupCustodyProbe& operator=(const CStartupCustodyProbe&) = delete;
+    bool configure(SelectedCase, RecordSink, void* workerLocalSinkContext) noexcept;
+    Outcome run(const Aquamarine::SBackendOptions&,
+                const Hyprutils::Memory::CSharedPointer<Aquamarine::CSession>& mirror,
+                const Aquamarine::CDisplayAttemptScope& denyOnlyGuard) noexcept;
+    // Same-worker borrow only. Does not transfer/reset the retained outer holder.
+    const Hyprutils::Memory::CSharedPointer<Aquamarine::CBackend>& backend() const noexcept;
+    Outcome outcome() const noexcept;
+    bool afterRealResourceScan(const Aquamarine::StartupCustodyTest::SWeakGraphView&) noexcept override;
+    bool afterRealImplementationStart(const Aquamarine::StartupCustodyTest::SWeakGraphView&, bool actualResult) noexcept override;
+    void childDestructorEntry(const Aquamarine::CDRMBackend*, Aquamarine::StartupCustodyTest::SProbeStamp) noexcept override;
+  private:
+    struct SState;
+    std::unique_ptr<SState> m_state; // owns frozen RetainedCase as SState.call
+};
+} // namespace Pokelinux::StartupCustodyTest
