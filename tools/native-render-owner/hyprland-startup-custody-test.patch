+        if (!broker || terminal || broker->transportFailed()) throw std::runtime_error("input broker unavailable");
+        std::array<SSessionPendingEvent, PR_EXECUTOR_MAX_BOOTSTRAP_EVENTS> batch{};
+        size_t count = 0;
+        if (broker->peekInitialRenderEvents(batch.data(), batch.size(), &count) != eSessionInitialRenderEventsResult::READY)
+            throw std::runtime_error("initial broker batch unavailable");
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+        const auto serviceDevice = testDevice(broker);
+        const auto head = broker->peekPendingRenderEvent();
+        const bool queueAdvanced = !head || !count || head->metadata.session_sequence != batch[0].metadata.session_sequence;
+        if (!serviceDevice.valid) throw std::runtime_error("startup test graphics device unavailable");
+        traceRequired(trace, "BROKER_INITIAL_BATCH_READY", std::format(
+            R"(,"events":{},"graphics_devices":{},"real_service_lease_retained":{},"queue_advanced":{},"session_generation":{})",
+            count, serviceDevice.graphics, boolean(serviceDevice.valid), boolean(queueAdvanced), generation) + deviceFields(serviceDevice));
+#endif
+        std::array<PrBootstrapEventV1, PR_EXECUTOR_MAX_BOOTSTRAP_EVENTS> copied{};
+        for (size_t i = 0; i < count; ++i) {
+            copied[i].metadata = copyEvent(batch[i].metadata);
+            copied[i].primary_fd = batch[i].primary_fd;
+            copied[i].render_fd = batch[i].render_fd;
+        }
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+        const auto captureEnter = boottime();
+#endif
+        const auto captured = pr_bootstrap_capture_v1(generation, copied.data(), uint32_t(count), &pack);
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+        const auto captureReturn = boottime();
+        bool pendingOpen = true;
+        for (size_t i = 0; i < count; ++i)
+            for (const int fd : {batch[i].primary_fd, batch[i].render_fd})
+                if (fd >= 0) pendingOpen = pendingOpen && characterFD(fd);
+        traceRequired(trace, "RUST_BOOTSTRAP_CAPTURED", std::format(
+            R"(,"enter_ns":{},"return_ns":{},"code":{},"events":{},"opaque_capture_handle_nonnull":{},"source_pending_and_service_FDs_still_open":{})",
+            captureEnter, captureReturn, captured, count, boolean(!!pack), boolean(pendingOpen && testDevice(broker).valid)));
+#endif
+        if (captured != PR_EXECUTOR_OK || !pack) throw std::runtime_error("Rust bootstrap capture unavailable");
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+        const auto markEnter = boottime();
