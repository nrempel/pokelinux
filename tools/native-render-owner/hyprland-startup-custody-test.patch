+    Stamp ownerStamp{},enterStamp{},returnStamp{};
+    uint64_t errors=0,sessionGeneration=0,leaseID=0,deviceGeneration=0,rdev=0;
+    uint32_t scanCallbacks=0,startCallbacks=0,matchedDtors=0;
+    size_t recordCount=0,recordBytes=0;
+    bool configured=false,runEntered=false,running=false,scopeBound=false,injected=false,callReturned=false;
+    Outcome result=Outcome::UNQUALIFIED;
+
+    bool stampValid(Stamp stamp) noexcept {
+        const bool ok=stamp.valid && stamp.tid && stamp.tid==ownerStamp.tid && stamp.boottimeNs;
+        if(!ok) { errors|=BAD_CLOCK; }
+        return ok;
+    }
+    bool send(CJson& j,const char* event,Stamp stamp) noexcept {
+        const int saved=errno;
+        if(!j.good){
+            errors|=BAD_RECORD;
+            CJson fallback;caseFields(fallback,selected);fallback.field("setup_error_bits",errors);fallback.field("setup_qualified",false);
+            const bool ok=send(fallback,event,stamp);errno=saved;return ok;
+        }
+        if(!sink || recordCount>=RECORDS_MAX || j.used>BYTES_MAX-recordBytes){errors|=BAD_RECORD;errno=saved;return false;}
+        ++recordCount;recordBytes+=j.used;
+        const bool ok=sink(sinkContext,event,stamp,j.view());if(!ok)errors|=BAD_SINK;
+        errno=saved;return ok;
+    }
+    bool boundaryValid(const Graph& v,bool atStart) noexcept {
+        bool ok=stampValid(v.stamp) && v.childIdentity && v.atomic && v.nativeImplementationPresent && !v.overflow &&
+            v.sessionGeneration==sessionGeneration && v.deviceLeaseID==leaseID && v.deviceGeneration==deviceGeneration && v.deviceRdev==rdev &&
+            v.connectorCount>0 && v.connectorCount<=Hook::MAX_OUTPUTS && v.crtcCount>0 && v.crtcCount<=Hook::MAX_CRTCS &&
+            v.planeCount>0 && v.planeCount<=Hook::MAX_PLANES && v.capturedOutputCount>0 && v.capturedOutputCount<=v.connectorCount &&
+            v.capturedCrtcCount==v.crtcCount && v.capturedPlaneCount==v.planeCount &&
+            !v.primaryAllocatorPresent && !v.rendererAllocatorPresent && !v.rendererPresent && v.dumbAllocatorPresent==atStart &&
+            !!call.backend && call.backend->session && call.backend->session->isRenderMirror() && call.backend->session->onOwnerThread();
+        if(v.capturedOutputCount>v.outputs.size() || v.capturedCrtcCount>v.crtcs.size() || v.capturedPlaneCount>v.planes.size())ok=false;
+        for(uint32_t i=0;i<v.capturedOutputCount && i<v.outputs.size();++i){
+            if(!v.outputs[i].connectorID || !v.outputs[i].modeCount)ok=false;
+            for(uint32_t k=0;k<i;++k)if(v.outputs[i].connectorID==v.outputs[k].connectorID)ok=false;
+        }
+        for(uint32_t i=0;i<v.capturedCrtcCount && i<v.crtcIDs.size();++i){
+            if(!v.crtcIDs[i]) { ok=false; }
+            for(uint32_t k=0;k<i;++k)if(v.crtcIDs[i]==v.crtcIDs[k])ok=false;
+        }
+        for(uint32_t i=0;i<v.capturedPlaneCount && i<v.planeIDs.size();++i){
+            if(!v.planeIDs[i]) { ok=false; }
+            for(uint32_t k=0;k<i;++k)if(v.planeIDs[i]==v.planeIDs[k])ok=false;
+        }
+        if(!ok) { errors|=BAD_BOUNDARY; }
+        return ok;
+    }
+    void injection(bool atStart) noexcept {
+        // No observation weak lock has occurred before this branch. Copying
+        // Graph increments weak counts only; call.backend is the actual holder.
+        const Stamp stamp=Hook::probeStamp();stampValid(stamp);
+        CJson j;caseFields(j,selected);
+        j.field("boundary_reached",true);j.field("injection_returned_true",true);j.field("hook_scope_bound",scopeBound);
+        j.field("outer_holder_retained",!!call.backend);j.field("retained_case_is_owner_member",true);
+        j.field("all_observation_locks_released_before_injection",true);
+        j.text("injected_action",atStart ? "EFFECTIVE_FALSE_AFTER_REAL_IMPLEMENTATION_START" : "CONTINUE_AFTER_REAL_RESOURCE_SCAN");
+        j.raw(",\"actual_impl_start_result\":");j.raw(atStart ? "true" : "null");
+        j.raw(",\"effective_impl_start_result\":");j.raw(atStart ? "false" : "null");
+        j.field("boundary_boottime_ns",graph.stamp.boottimeNs);j.raw(",\"graph\":");graphJson(j,graph);
+        send(j,"CUSTODY_INJECTION",stamp);
+    }
+    SObserved observeWeak() noexcept {
+        SObserved out{};
+        if(!injected)return out;
+        // Every strong observation handle is automatic INSIDE one of the
+        // following scopes, after frozen exercise returned. None is retained.
+        try {
+            out.child.present=true;
+            {auto child=graph.child.lock();out.child.alive=!!child;
+             if(child)out.child.matches=child.get()==graph.childIdentity && child->type()==AQ_BACKEND_DRM && realCharacterDevice(child->drmFD(),rdev);}
+            out.device.present=true;
+            {auto device=graph.device.lock();out.device.alive=!!device;
+             if(device)out.device.matches=device->sessionGenerationTag==sessionGeneration && device->leaseID==leaseID && device->generation==deviceGeneration &&
+                 static_cast<uint64_t>(device->dev)==rdev && !device->retiring && realCharacterDevice(device->fd,rdev);}
+            out.dumb.present=graph.dumbAllocatorPresent;
+            if(out.dumb.present){auto dumb=graph.dumbAllocator.lock();out.dumb.alive=!!dumb;
+                if(dumb){auto owner=dumb->getBackend();out.dumb.matches=owner.get()==call.backend.get() && realCharacterDevice(dumb->drmFD(),rdev);}}
+            for(uint32_t i=0;i<graph.capturedOutputCount;++i){
+                auto& result=out.outputs[i];result.present=true;
+                auto output=graph.outputs[i].output.lock();result.alive=!!output;
+                if(output){auto child=output->getBackend();result.matches=output->getConnectorID()>0 && uint64_t(output->getConnectorID())==graph.outputs[i].connectorID &&
+                    output->modes.size()==graph.outputs[i].modeCount && child.get()==graph.childIdentity;}
+            }
+            for(uint32_t i=0;i<graph.capturedCrtcCount;++i){
+                auto& result=out.crtcs[i];result.present=true;auto crtc=graph.crtcs[i].lock();result.alive=!!crtc;
+                if(crtc){auto child=crtc->backend.lock();result.matches=crtc->id==graph.crtcIDs[i] && child.get()==graph.childIdentity;}
+            }
+            for(uint32_t i=0;i<graph.capturedPlaneCount;++i){
+                auto& result=out.planes[i];result.present=true;auto plane=graph.planes[i].lock();result.alive=!!plane;
+                if(plane){auto child=plane->backend.lock();result.matches=plane->id==graph.planeIDs[i] && child.get()==graph.childIdentity;}
+            }
+        } catch(...){errors|=BAD_WEAK_CALL;}
+        aggregate(out,out.child);aggregate(out,out.device);aggregate(out,out.dumb);
+        for(uint32_t i=0;i<graph.capturedOutputCount;++i)aggregate(out,out.outputs[i]);
+        for(uint32_t i=0;i<graph.capturedCrtcCount;++i)aggregate(out,out.crtcs[i]);
+        for(uint32_t i=0;i<graph.capturedPlaneCount;++i)aggregate(out,out.planes[i]);
+        return out; // result has booleans only; all locks already destroyed
+    }
+};
+
+CStartupCustodyProbe::CStartupCustodyProbe() : m_state(std::make_unique<SState>()) {}
+CStartupCustodyProbe::~CStartupCustodyProbe() noexcept {
+    // No StopRetire/drain is implemented in this fixture. Never auto-destroy
+    // even the outer native graph by dropping a failed probe or wrong thread.
+    if(!onOwnerThread() || (m_state && m_state->call.backend))std::terminate();
+}
+bool CStartupCustodyProbe::configure(SelectedCase which,RecordSink sink,void* context) noexcept {
+    if(!onOwnerThread())return false;
+    auto& s=*m_state;
+    if(s.configured || s.runEntered || !validCase(which) || !sink){s.errors|=BAD_CONFIG;return false;}
+    s.ownerStamp=Hook::probeStamp();
+    if(!s.ownerStamp.valid){s.errors|=BAD_CLOCK;return false;}
+    s.selected=which;s.sink=sink;s.sinkContext=context;s.configured=true;return true;
+}
+const Hyprutils::Memory::CSharedPointer<CBackend>& CStartupCustodyProbe::backend() const noexcept {
+    if(!onOwnerThread()) { std::terminate(); }
+    return m_state->call.backend;
+}
+Outcome CStartupCustodyProbe::outcome() const noexcept {return onOwnerThread() ? m_state->result : Outcome::UNQUALIFIED;}
+
+bool CStartupCustodyProbe::afterRealResourceScan(const Graph& view) noexcept {
+    if(!onOwnerThread())return false;
+    auto& s=*m_state;++s.scanCallbacks;
+    if(!s.running || !s.scopeBound || Hook::CProbeScope::current()!=this || s.scanCallbacks!=1){s.errors|=BAD_ORDER;return false;}
+    if(s.selected!=SelectedCase::AFTER_REAL_RESOURCE_SCAN)return false;
+    if(s.injected || !s.boundaryValid(view,false))return false;
+    s.graph=view;s.injected=true;s.injection(false);return true; // true even if record sink failed
+}
+bool CStartupCustodyProbe::afterRealImplementationStart(const Graph& view,bool actualResult) noexcept {
+    if(!onOwnerThread())return false;
+    auto& s=*m_state;++s.startCallbacks;
+    if(!s.running || !s.scopeBound || Hook::CProbeScope::current()!=this || s.startCallbacks!=1 || s.scanCallbacks!=1 ||
+        s.selected!=SelectedCase::AFTER_REAL_IMPLEMENTATION_START || s.injected || !actualResult){s.errors|=BAD_ORDER;return false;}
+    if(!s.boundaryValid(view,true))return false;
+    s.graph=view;s.injected=true;s.injection(true);return true;
+}
+void CStartupCustodyProbe::childDestructorEntry(const CDRMBackend* identity,Stamp stamp) noexcept {
+    if(!onOwnerThread())return;
+    auto& s=*m_state;
+    if(!s.injected || identity!=s.graph.childIdentity)return;
+    if(s.matchedDtors==std::numeric_limits<uint32_t>::max()){s.errors|=BAD_ORDER;return;}
+    ++s.matchedDtors;
+    if(!s.running || s.callReturned || s.matchedDtors!=1)s.errors|=BAD_ORDER;
+    s.stampValid(stamp);
+    if(s.matchedDtors!=1)return; // no repeated fabricated records for one actual child
+    CJson j;caseFields(j,s.selected);
+    j.field("matched_selected_child",true);j.field("cleanup_completion_claim",false);
+    s.send(j,"MATCHED_CHILD_DESTRUCTOR_ENTERED",stamp);
+}
+
+Outcome CStartupCustodyProbe::run(const SBackendOptions& options,const Hyprutils::Memory::CSharedPointer<CSession>& mirror,
+                                  const CDisplayAttemptScope& guard) noexcept {
+    if(!onOwnerThread())return Outcome::UNQUALIFIED; // do not read mutable state on foreign thread
+    auto& s=*m_state;
+    if(!s.configured || s.runEntered){s.errors|=BAD_CONFIG;return Outcome::UNQUALIFIED;}
+    s.runEntered=true;
+    if(!mirror || !mirror->isRenderMirror() || !mirror->onOwnerThread() || !mirror->active || !mirror->initialEnumerationComplete()){
+        s.errors|=BAD_MIRROR;return Outcome::UNQUALIFIED;
+    }
+    size_t devices=0;
+    for(const auto& device:mirror->sessionDevices){
+        if(!device || !device->leaseID)continue;
+        ++devices;
+        struct stat render{};
+        if(device->retiring || !device->sessionGenerationTag || !device->generation || !device->dev ||
+            !realCharacterDevice(device->fd,static_cast<uint64_t>(device->dev)) || device->renderNodeFd<0 ||
+            ::fstat(device->renderNodeFd,&render)!=0 || !S_ISCHR(render.st_mode) || render.st_rdev==device->dev){s.errors|=BAD_MIRROR;return Outcome::UNQUALIFIED;}
+        s.sessionGeneration=device->sessionGenerationTag;s.leaseID=device->leaseID;s.deviceGeneration=device->generation;s.rdev=static_cast<uint64_t>(device->dev);
+    }
+    if(devices!=1){s.errors|=BAD_MIRROR;return Outcome::UNQUALIFIED;}
+    Hook::CProbeScope scope(*this);s.scopeBound=scope.bound();
+    if(!s.scopeBound || !guard.bound()){s.errors|=BAD_SCOPE;return Outcome::UNQUALIFIED;}
+    s.enterStamp=Hook::probeStamp();if(!s.stampValid(s.enterStamp))return Outcome::UNQUALIFIED;
+    s.running=true;
+    exercise(s.call,s.selected==SelectedCase::AFTER_REAL_RESOURCE_SCAN ? Case::AFTER_REAL_RESOURCE_SCAN : Case::AFTER_REAL_IMPLEMENTATION_START,options,mirror);
+    s.returnStamp=Hook::probeStamp();s.callReturned=true;s.stampValid(s.returnStamp);
+    if(s.returnStamp.boottimeNs<s.enterStamp.boottimeNs ||
+        (s.injected && (s.graph.stamp.boottimeNs<s.enterStamp.boottimeNs || s.graph.stamp.boottimeNs>s.returnStamp.boottimeNs)))s.errors|=BAD_CLOCK;
+    const bool correctReturn=s.call.entered && s.call.backend && s.call.initializeCalled && !s.call.unexpectedException && s.call.expectedInjectedFailureReturned &&
+        (s.selected==SelectedCase::AFTER_REAL_RESOURCE_SCAN ? (!s.call.initializeReturned && !s.call.startCalled && !s.call.startReturned && s.startCallbacks==0) :
+          (s.call.initializeReturned && s.call.startCalled && !s.call.startReturned && s.startCallbacks==1));
+    if(!correctReturn || !s.injected || s.scanCallbacks!=1)s.errors|=BAD_RETURN;
+    {
+        const Stamp stamp=Hook::probeStamp();s.stampValid(stamp);
+        CJson j;caseFields(j,s.selected);
+        j.field("enter_ns",s.enterStamp.boottimeNs);j.field("return_ns",s.returnStamp.boottimeNs);
+        j.field("entered",s.call.entered);j.field("initialize_called",s.call.initializeCalled);j.field("initialize_returned",s.call.initializeReturned);
+        j.field("start_called",s.call.startCalled);j.field("start_returned",s.call.startReturned);j.field("unexpected_exception",s.call.unexpectedException);
+        j.field("expected_injected_failure_returned",s.call.expectedInjectedFailureReturned);j.field("outer_holder_retained",!!s.call.backend);
+        j.field("setup_error_bits",s.errors);s.send(j,"CUSTODY_CALL_RETURNED",stamp);
+    }
+    const SObserved observed=s.observeWeak(); // contains no handles; all lock scopes ended
+    const auto& gate=guard.result();
+    if(!guard.bound() || gate.sealed || gate.attempted)s.errors|=BAD_GATE;
+    {
+        const Stamp stamp=Hook::probeStamp();s.stampValid(stamp);
+        CJson j;caseFields(j,s.selected);
+        j.field("outer_holder_retained",!!s.call.backend);j.field("all_observation_locks_released",true);
+        j.field("matched_child_destructor_entries",uint64_t(s.matchedDtors));j.field("setup_error_bits",s.errors);j.field("setup_qualified",s.errors==0);
+        j.raw(",\"child\":");weakJson(j,observed.child);j.raw(",\"device\":");weakJson(j,observed.device);j.raw(",\"dumb_allocator\":");weakJson(j,observed.dumb);
+        j.raw(",\"outputs\":[");
+        for(uint32_t i=0;i<s.graph.capturedOutputCount;++i){if(i) { j.raw(","); }
+        j.raw("{\"captured_id\":");j.number(s.graph.outputs[i].connectorID);j.raw(",");weakFields(j,observed.outputs[i]);j.raw("}");}
+        j.raw("],\"crtcs\":[");
+        for(uint32_t i=0;i<s.graph.capturedCrtcCount;++i){if(i) { j.raw(","); }
+        j.raw("{\"captured_id\":");j.number(s.graph.crtcIDs[i]);j.raw(",");weakFields(j,observed.crtcs[i]);j.raw("}");}
+        j.raw("],\"planes\":[");
+        for(uint32_t i=0;i<s.graph.capturedPlaneCount;++i){if(i) { j.raw(","); }
+        j.raw("{\"captured_id\":");j.number(s.graph.planeIDs[i]);j.raw(",");weakFields(j,observed.planes[i]);j.raw("}");}
+        j.raw("],\"current_graph\":null,\"native_gate\":{\"deny_only_scope_bound\":");j.value(guard.bound());
+        j.field("native_sealed",gate.sealed);j.field("native_attempted",gate.attempted);j.field("request_recorded",gate.info.kind!=0);
+        j.field("additional_refused",gate.additional_refused);j.field("cleanup_acknowledged",false);j.field("retirement_authority_used",false);j.raw("}");
+        s.send(j,"CUSTODY_WEAK_OBSERVED",stamp);
+    }
+    s.running=false;
+    if(s.errors)return s.result=Outcome::UNQUALIFIED;
+    if(s.matchedDtors || observed.lost)return s.result=Outcome::CUSTODY_LOST;
+    if(observed.metadataMatches)return s.result=Outcome::RETAINED;
+    return s.result=Outcome::UNQUALIFIED;
+}
+} // namespace Pokelinux::StartupCustodyTest
