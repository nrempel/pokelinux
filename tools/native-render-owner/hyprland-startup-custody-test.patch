+uint64_t boottime() {
+    timespec value{};
+    if (clock_gettime(CLOCK_BOOTTIME, &value) != 0 || value.tv_sec < 0)
+        throw std::runtime_error("startup CLOCK_BOOTTIME unavailable");
+    return uint64_t(value.tv_sec) * 1'000'000'000ULL + uint64_t(value.tv_nsec);
+}
+
+struct FD {
+    int value = -1;
+    explicit FD(int fd = -1) : value(fd) {}
+    ~FD() { if (value >= 0) close(value); }
+    FD(const FD&) = delete;
+    FD& operator=(const FD&) = delete;
+    int take() { const int fd = value; value = -1; return fd; }
+};
+
+int duplicate(int borrowed) {
+    if (borrowed < 0)
+        return -1;
+    const int result = fcntl(borrowed, F_DUPFD_CLOEXEC, 0);
+    if (result < 0)
+        throw std::runtime_error("startup descriptor duplication failed");
+    return result;
+}
