+bool characterFD(int fd, uint64_t* device = nullptr) {
+    struct stat value{};
+    if (fd < 0 || fcntl(fd, F_GETFD) < 0 || fstat(fd, &value) != 0 || !S_ISCHR(value.st_mode)) return false;
+    if (device) *device = uint64_t(value.st_rdev);
+    return true;
+}
+bool closedFD(int fd) { return fd >= 0 && fcntl(fd, F_GETFD) < 0 && errno == EBADF; }
+STestDevice testDevice(const Pointer<CSession>& session) {
+    STestDevice result{};
+    size_t selected = 0;
+    for (const auto& device : session->sessionDevices) {
+        if (!device || !device->leaseID) continue;
+        ++selected;
+        result.lease = device->leaseID;
+        result.generation = device->generation;
+        result.valid = !device->retiring && characterFD(device->fd, &result.primary) &&
+            characterFD(device->renderNodeFd, &result.render) && result.primary == uint64_t(device->dev) &&
+            result.primary != result.render;
+    }
+    result.graphics = selected;
+    result.valid = result.valid && selected == 1;
+    return result;
+}
+std::string deviceFields(const STestDevice& device) {
