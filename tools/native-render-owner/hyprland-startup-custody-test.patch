+// Constructed empty and retained by Rust BEFORE any native acquisition. This
+// type is never constructed on main and retains no pointer to control/broker.
+struct SNativeOwner {
+    const std::thread::id thread = std::this_thread::get_id();
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+    // Only CPU clock/TID observations at creation; trace IO opens at bootstrap.
+    const Pokelinux::StartupCustodyTest::STraceStamp createdAt = TestTrace::stamp();
+    TestTrace trace;
+    Pokelinux::StartupCustodyTest::CStartupCustodyProbe custody;
+    bool pendingTraced = false;
+#endif
+    Pointer<CSession> mirror;
+    Pointer<CBackend> backend;
+    struct SOutput {
+        Pointer<IOutput> output;
+        Pointer<SOutputMode> mode;
+        PrDiscoveredOutputV1 values{};
+    };
+    std::array<SOutput, PR_EXECUTOR_MAX_OUTPUTS> outputs{};
+    uint32_t outputCount = 0;
+    bool outputFailure = false;
+    Hyprutils::Signal::CHyprSignalListener outputListener;
+    struct SSource {
+        Pointer<SPollFD> poll;
+        uint64_t token = 0;
+        int fd = -1;
+    };
+    std::array<SSource, PR_EXECUTOR_MAX_SOURCES> sources{};
+    uint32_t sourceCount = 0;
+    uint64_t nextSource = 0;
+
+    void copyOutput(const Pointer<IOutput>& output) noexcept {
+        try {
+            if (std::this_thread::get_id() != thread || !output || outputCount == outputs.size())
+                throw std::runtime_error("unavailable output registry");
+            for (uint32_t i = 0; i < outputCount; ++i)
+                if (outputs[i].output == output)
+                    throw std::runtime_error("duplicate output discovery");
+            // Retain the real native output before asking it for more state.
+            auto& entry = outputs[outputCount++];
+            entry.output = output;
+            entry.mode = output->preferredMode();
+            auto implementation = output->getBackend();
+            auto drm = Hyprutils::Memory::dynamicPointerCast<CDRMOutput>(output);
+            if (!entry.mode || !drm || !implementation || implementation->type() != AQ_BACKEND_DRM)
+                throw std::runtime_error("unsupported output or mode");
+            Pointer<CSessionDevice> device;
+            const int fd = implementation->drmFD();
+            struct stat identity{};
+            if (fd < 0 || fstat(fd, &identity) != 0 || !S_ISCHR(identity.st_mode))
+                throw std::runtime_error("unbound output device");
+            for (const auto& candidate : mirror->sessionDevices)
+                if (candidate->leaseID && !candidate->retiring && candidate->fd == fd && candidate->dev == identity.st_rdev)
+                    device = candidate;
+            const auto& mode = entry.mode;
+            if (!device || mode->pixelSize.x <= 0 || mode->pixelSize.y <= 0 || mode->pixelSize.x > 16384 || mode->pixelSize.y > 16384 ||
+                std::floor(mode->pixelSize.x) != mode->pixelSize.x || std::floor(mode->pixelSize.y) != mode->pixelSize.y || !mode->refreshRate)
+                throw std::runtime_error("unbound output mode");
+            // The registry key is assigned only AFTER retaining the corresponding
+            // genuine output/mode; it is not a connector or control monitor ID.
+            auto& value = entry.values;
+            value.output_id = outputCount;
+            value.output_generation = device->generation;
+            value.device_lease_id = device->leaseID;
+            value.device_generation = device->generation;
+            value.mode_id = outputCount;
+            value.mode_generation = device->generation;
+            const int connector = drm->getConnectorID();
+            if (connector <= 0) throw std::runtime_error("invalid native connector identity");
+            value.connector_id = uint32_t(connector);
+            value.width = uint32_t(mode->pixelSize.x);
+            value.height = uint32_t(mode->pixelSize.y);
+            value.refresh_millihz = mode->refreshRate;
+            const auto formats = output->getRenderFormats();
+            if (formats.empty() || formats.front().modifiers.empty())
+                throw std::runtime_error("no native format observation");
+            value.drm_format = formats.front().drmFormat;
+            value.modifier = formats.front().modifiers.front();
+            value.flags = output->nonDesktop ? 1u : 0u;
+            if (!value.connector_id || !value.drm_format)
+                throw std::runtime_error("invalid native output metadata");
+        } catch (...) {
+            outputFailure = true;
+        }
+    }
+};
+
+void* createNative(const PrOwnerOptionsV1*) noexcept {
+    try { return new SNativeOwner(); } catch (...) { return nullptr; }
+}
+void destroyNative(void* opaque) noexcept {
+    // Rust invokes this only after aggregate verified shutdown. That branch is
+    // deliberately unavailable while this adapter still lacks StopRetire/drain.
+    auto* owner = static_cast<SNativeOwner*>(opaque);
+    if (owner && (owner->mirror || owner->backend))
+        std::terminate();
+    delete owner;
+}
+int32_t bootstrapNative(void* opaque, const PrBootstrapViewV1* input, PrDiscoveryV1* result) noexcept {
+    try {
+        auto& owner = *static_cast<SNativeOwner*>(opaque);
+        if (owner.thread != std::this_thread::get_id() || !input || !result || owner.mirror || !input->events || !input->event_count)
+            return PR_EXECUTOR_PROTOCOL;
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+        if (!owner.trace.open(2) || !owner.createdAt.valid ||
+            !owner.trace.emitStamped("NATIVE_HOLDER_CREATED", owner.createdAt, ",\"CPU_only_empty\":true"))
+            return PR_EXECUTOR_NATIVE;
+        const auto mirrorEnter = boottime();
+        std::array<uint64_t, PR_EXECUTOR_MAX_BOOTSTRAP_EVENTS> appliedSequences{}, applyResults{};
+        bool borrowedCloexec = true, duplicated = true;
+        if (input->event_count > appliedSequences.size()) return PR_EXECUTOR_CAPACITY;
+#endif
+        // This is deny-only. Initial allocation can have native effects (client
+        // caps, allocator lease/FDs, GBM/EGL); it grants no display mutation.
+        CDisplayAttemptScope guard(eDisplayAttemptDomain::RENDER, denyDisplay, &owner);
+        owner.mirror = CSession::createRenderMirror(input->session_generation);
+        if (!owner.mirror)
+            return PR_EXECUTOR_NATIVE;
+        for (uint32_t i = 0; i < input->event_count; ++i) {
+            const auto& event = input->events[i];
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+            for (const int borrowed : {event.primary_fd, event.render_fd}) {
+                if (borrowed >= 0) {
+                    const int flags = fcntl(borrowed, F_GETFD);
+                    borrowedCloexec = borrowedCloexec && flags >= 0 && (flags & FD_CLOEXEC) && characterFD(borrowed);
+                }
+            }
+#endif
+            FD primary(duplicate(event.primary_fd));
+            FD render(duplicate(event.render_fd));
+            const auto copied = copyEvent(event.metadata);
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+            for (const auto pair : {std::pair{event.primary_fd, primary.value}, std::pair{event.render_fd, render.value}}) {
+                if (pair.first < 0) { duplicated = duplicated && pair.second == -1; continue; }
+                uint64_t originalRdev = 0, copyRdev = 0;
+                const int flags = fcntl(pair.second, F_GETFD);
+                duplicated = duplicated && pair.first != pair.second && characterFD(pair.first, &originalRdev) &&
+                    characterFD(pair.second, &copyRdev) && originalRdev == copyRdev && flags >= 0 && (flags & FD_CLOEXEC);
+            }
+#endif
+            // applyRenderEvent consumes BOTH descriptors on every path. The
+            // borrowed Rust originals stay Rust-owned through verified shutdown.
+            const auto applied = owner.mirror->applyRenderEvent(copied, primary.take(), render.take());
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+            appliedSequences[i] = event.metadata.session_sequence;
+            applyResults[i] = uint64_t(applied);
+#endif
+            if (applied != eSessionApply::APPLIED_METADATA)
+                return PR_EXECUTOR_NATIVE;
+        }
+        if (!owner.mirror->initialEnumerationComplete() || !owner.mirror->active)
+            return PR_EXECUTOR_NATIVE;
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+        const auto mirrorReturn = boottime();
+        const auto mirrored = testDevice(owner.mirror);
+        if (!mirrored.valid || !borrowedCloexec || !duplicated) return PR_EXECUTOR_NATIVE;
+        traceRequired(owner.trace, "MIRROR_ENUM_APPLIED", std::format(
+            R"(,"enter_ns":{},"return_ns":{},"session_generation":{},"applied_sequences":{},"all_apply_results":{},"owned_FDs_duplicated_from_Rust_borrows":{},"Rust_borrow_FDs_CLOEXEC_verified":{},"enumerated":{},"active":{})",
+            mirrorEnter, mirrorReturn, input->session_generation, numberArray(appliedSequences.data(), input->event_count),
+            numberArray(applyResults.data(), input->event_count), boolean(duplicated), boolean(borrowedCloexec),
+            boolean(owner.mirror->initialEnumerationComplete()), boolean(owner.mirror->active)) + deviceFields(mirrored));
+#endif
+        SBackendOptions options;
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+        const auto sink = +[](void* opaqueTrace, const char* event, Aquamarine::StartupCustodyTest::SProbeStamp stamp, std::string_view fields) noexcept {
+            auto& trace = *static_cast<TestTrace*>(opaqueTrace);
+            return trace.emitStamped(event, {stamp.boottimeNs, stamp.tid, stamp.valid}, fields);
+        };
+        if (!owner.custody.configure(static_cast<Aquamarine::StartupCustodyTest::eCase>(owner.trace.caseSelection()), sink, &owner.trace))
+            return PR_EXECUTOR_NATIVE;
+        const auto outcome = owner.custody.run(options, owner.mirror, guard);
+        owner.backend = owner.custody.backend(); // RetainedCase already owned this before initialize.
+        (void)outcome; // Native failure is expected for either selected injection; oracle assesses custody separately.
+        return PR_EXECUTOR_NATIVE;
+#else
+        // Empty holder first, assigned into the retained worker owner BEFORE
+        // native initialization. Child failure custody remains a separate gate.
+        owner.backend = CBackend::createRenderSessionHolder(options, owner.mirror);
+        if (!owner.backend || !owner.backend->initializeRenderSession())
+            return PR_EXECUTOR_NATIVE;
+        owner.outputListener = owner.backend->events.newOutput.listen([&owner](const Pointer<IOutput>& output) { owner.copyOutput(output); });
+        const bool started = owner.backend->start();
+        if (!started || !owner.backend->primaryAllocator || owner.outputFailure || !owner.outputCount || !noDisplayRequest(guard))
+            return PR_EXECUTOR_NATIVE;
+        PrDiscoveryV1 candidate{};
+        candidate.session_generation = input->session_generation;
+        candidate.output_count = owner.outputCount;
+        for (uint32_t i = 0; i < owner.outputCount; ++i)
+            candidate.outputs[i] = owner.outputs[i].values;
+        *result = candidate;
+        return PR_EXECUTOR_OK;
+#endif
+    } catch (...) { return PR_EXECUTOR_NATIVE; }
+}
+int32_t prepareNative(void*, const PrFrame*, const PrAdmissionV1*) noexcept { return PR_EXECUTOR_PROTOCOL; }
+int32_t executeNative(void*, const PrFrame*, const PrAdmissionV1*, PrAttempt*, PrNativeResultV1*) noexcept { return PR_EXECUTOR_PROTOCOL; }
+int32_t advanceNative(void*, const PrRetirementContextV1*, PrNativeProgressV1* result) noexcept {
+    if (!result) return PR_EXECUTOR_INVALID;
+    *result = {};
+    return PR_EXECUTOR_OK;
+}
+int32_t pollNative(void* opaque, PrPollSourceV1* storage, uint32_t capacity, uint32_t* count) noexcept {
+    try {
+        auto& owner = *static_cast<SNativeOwner*>(opaque);
+        if (owner.thread != std::this_thread::get_id() || !storage || !count)
+            return PR_EXECUTOR_PROTOCOL;
+        const auto current = owner.backend ? owner.backend->getPollFDs() : std::vector<Pointer<SPollFD>>{};
+        if (current.size() > capacity || current.size() > owner.sources.size())
+            return PR_EXECUTOR_CAPACITY;
+        std::array<SNativeOwner::SSource, PR_EXECUTOR_MAX_SOURCES> next{};
+        std::array<PrPollSourceV1, PR_EXECUTOR_MAX_SOURCES> values{};
+        for (size_t i = 0; i < current.size(); ++i) {
+            if (!current[i] || current[i]->fd < 0 || !current[i]->onSignal)
+                return PR_EXECUTOR_PROTOCOL;
+            for (size_t j = 0; j < i; ++j)
+                if (current[i]->fd == current[j]->fd)
+                    return PR_EXECUTOR_PROTOCOL;
+            uint64_t token = 0;
+            for (uint32_t j = 0; j < owner.sourceCount; ++j)
+                if (owner.sources[j].poll == current[i] && owner.sources[j].fd == current[i]->fd)
+                    token = owner.sources[j].token;
+            if (!token) {
+                if (owner.nextSource == std::numeric_limits<uint64_t>::max()) return PR_EXECUTOR_EXHAUSTED;
+                token = ++owner.nextSource;
+            }
+            next[i] = {current[i], token, current[i]->fd};
+            values[i].fd = current[i]->fd;
+            values[i].token = token;
+            values[i].generation = token;
+            values[i].events = POLLIN;
+        }
+        owner.sources = std::move(next);
+        owner.sourceCount = uint32_t(current.size());
+        std::copy_n(values.begin(), current.size(), storage);
+        *count = owner.sourceCount;
+        return PR_EXECUTOR_OK;
+    } catch (...) { return PR_EXECUTOR_NATIVE; }
+}
+int32_t dispatchNative(void* opaque, const PrNativeReadyV1* ready) noexcept {
+    try {
+        auto& owner = *static_cast<SNativeOwner*>(opaque);
+        if (owner.thread != std::this_thread::get_id() || !ready) return PR_EXECUTOR_PROTOCOL;
+        for (uint32_t i = 0; i < owner.sourceCount; ++i) {
+            const auto& source = owner.sources[i];
+            if (source.token != ready->source.token || source.token != ready->source.generation || source.fd != ready->source.fd || source.poll->fd != source.fd)
+                continue;
+            CDisplayAttemptScope guard(eDisplayAttemptDomain::RENDER, denyDisplay, &owner);
+            source.poll->onSignal();
+            return noDisplayRequest(guard) ? PR_EXECUTOR_OK : PR_EXECUTOR_NATIVE;
+        }
+        return PR_EXECUTOR_STALE;
+    } catch (...) { return PR_EXECUTOR_NATIVE; }
+}
+int32_t pendingShutdownNative(uint32_t* retired) noexcept {
+    if (!retired) return PR_EXECUTOR_INVALID;
+    // No authentic StopRetire/drain exists yet. Report Pending and retain the
+    // available graph and Rust bootstrap pack on this live owned worker.
+    *retired = 0;
+    return PR_EXECUTOR_OK;
+}
+int32_t shutdownNative(void* opaque, uint32_t* retired) noexcept {
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+    try {
+    auto& owner = *static_cast<SNativeOwner*>(opaque);
+    if (owner.thread != std::this_thread::get_id()) return PR_EXECUTOR_PROTOCOL;
+    const auto enter = TestTrace::stamp();
+    const auto status = pendingShutdownNative(retired);
+    const auto returned = TestTrace::stamp();
+    if (!enter.valid || !returned.valid) return PR_EXECUTOR_CLOCK;
+    if (retired && !owner.pendingTraced) {
+        owner.pendingTraced = true;
+        owner.trace.emit("NATIVE_SHUTDOWN_PENDING", std::format(
+            R"(,"enter_ns":{},"return_ns":{},"status":{},"resources_retired":{},"mirror_retained":{},"outer_backend_retained":{},"native_retirement":false)",
+            enter.boottimeNs, returned.boottimeNs, status, *retired, boolean(!!owner.mirror), boolean(!!owner.backend)));
+    }
+    // The interval above measures the real implementation return. This packet
+    // does not claim that the enclosing C ABI callback has already returned.
+    return status;
+    } catch (...) { return PR_EXECUTOR_NATIVE; }
+#else
+    (void)opaque;
+    return pendingShutdownNative(retired);
+#endif
+}
+const PrNativeOwnerFunctionsV1 FUNCTIONS = {
+    PR_EXECUTOR_ABI_V1, sizeof(PrNativeOwnerFunctionsV1), {}, createNative, destroyNative, bootstrapNative,
+    prepareNative, executeNative, advanceNative, pollNative, dispatchNative, shutdownNative
+};
+}
