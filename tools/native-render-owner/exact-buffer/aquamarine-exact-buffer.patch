+bool Aquamarine::CGBMBuffer::initializeExact(const SSwapchainOptions& options_, const SExactBufferRequest& request, SP<IBackendImplementation> implementation) {
+    // This private initializer is one-shot. Its holder is already in the
+    // swapchain's in-progress vector before the first native operation.
+    if (exactReceipt.result != eExactBufferResult::NOT_ATTEMPTED || bo)
+        return false;
+    exactReceipt.request = request;
+    exactReceipt.options = options_;
+    exactReceipt.exported = attrs;
+    if (!ExactInternal::validRequest(request) || !ExactInternal::validOptions(options_) || !exactAllocator || !exactAllocator->gbmDevice || !implementation) {
+        exactReceipt.result = eExactBufferResult::INVALID_REQUEST;
+        return false;
+    }
+    const auto output = options_.scanoutOutput.lock();
+    if (!dynamicPointerCast<CDRMBackend>(implementation) || !dynamicPointerCast<CDRMOutput>(output) ||
+        implementation->type() != AQ_BACKEND_DRM || output->getBackend() != implementation) {
+        exactReceipt.result = eExactBufferResult::INVALID_REQUEST;
+        return false;
+    }
+    if (!ExactInternal::bindDevice(exactAllocator->drmFD(), implementation->drmFD(), exactReceipt.device)) {
+        exactReceipt.result = eExactBufferResult::DEVICE_MISMATCH;
+        return false;
+    }
+
+    if (request.mode == eExactBufferMode::EXPLICIT) {
+        exactReceipt.modifiers_cap.count = 1;
+        errno = 0;
+        exactReceipt.modifiers_cap.result = drmGetCap(implementation->drmFD(), DRM_CAP_ADDFB2_MODIFIERS, &exactReceipt.modifiers_cap_value);
+        const int capError = errno;
+        exactReceipt.modifiers_cap.error = exactReceipt.modifiers_cap.result == 0 ? 0 : capError;
+        if (exactReceipt.modifiers_cap.result != 0) {
+            exactReceipt.result = eExactBufferResult::NATIVE_FAILURE;
+            return false;
+        }
+        if (exactReceipt.modifiers_cap_value != 1) {
+            exactReceipt.result = eExactBufferResult::MODIFIERS_UNAVAILABLE;
+            return false;
+        }
+    }
+
+    const uint64_t occurrence = nextExactBufferID();
+    if (!occurrence) {
+        exactReceipt.result = eExactBufferResult::NATIVE_FAILURE;
+        return false;
+    }
+    const auto width = static_cast<uint32_t>(options_.size.x), height = static_cast<uint32_t>(options_.size.y);
+    exactReceipt.flags = GBM_BO_USE_RENDERING | GBM_BO_USE_SCANOUT;
+    exactReceipt.create_count = 1;
+    if (request.mode == eExactBufferMode::IMPLICIT) {
+        exactReceipt.api = eExactAllocationAPI::GBM_BO_CREATE;
+        errno = 0;
+        bo = gbm_bo_create(exactAllocator->gbmDevice, width, height, options_.format, exactReceipt.flags);
+        const int createError = errno;
+        exactReceipt.create_error = bo ? 0 : createError;
+    } else {
+        exactReceipt.api = eExactAllocationAPI::GBM_BO_CREATE_WITH_MODIFIERS2;
+        exactReceipt.modifier_count = 1;
+        exactReceipt.requested_modifier = request.modifier;
+        errno = 0;
+        bo = gbm_bo_create_with_modifiers2(exactAllocator->gbmDevice, width, height, options_.format, &request.modifier, 1, exactReceipt.flags);
+        const int createError = errno;
+        exactReceipt.create_error = bo ? 0 : createError;
+    }
+    exactReceipt.returned_buffer = bo != nullptr;
+    if (!bo) {
+        exactReceipt.result = eExactBufferResult::NATIVE_FAILURE;
+        return false;
+    }
+    exactReceipt.buffer_id = occurrence;
+    exactReceipt.modifier_getter_count = 1;
+    exactReceipt.raw_modifier = gbm_bo_get_modifier(bo);
+    attrs.size = {static_cast<double>(gbm_bo_get_width(bo)), static_cast<double>(gbm_bo_get_height(bo))};
+    attrs.format = gbm_bo_get_format(bo);
+    attrs.modifier = exactReceipt.raw_modifier;
+    attrs.planes = gbm_bo_get_plane_count(bo);
+    size = attrs.size;
+
+    bool exported = attrs.planes > 0 && attrs.planes <= static_cast<int>(attrs.fds.size());
