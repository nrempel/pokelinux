+bool Aquamarine::CSwapchain::reconfigureExact(const SSwapchainOptions& options_, const SExactBufferRequest& request, std::vector<SExactAllocation>& attempts) {
+    exactOnly = true;
+    attempts.clear();
+    const auto implementation = backendImpl.lock();
+    const auto gbmAllocator = dynamicPointerCast<CGBMAllocator>(allocator);
+    const auto output = options_.scanoutOutput.lock();
+    if (!ExactInternal::validRequest(request) || !ExactInternal::validOptions(options_) || !gbmAllocator || !implementation ||
+        !dynamicPointerCast<CDRMBackend>(implementation) || !dynamicPointerCast<CDRMOutput>(output) ||
+        implementation->type() != AQ_BACKEND_DRM || output->getBackend() != implementation) {
+        SExactAllocation refused;
+        refused.request = request;
+        refused.options = options_;
+        refused.result = eExactBufferResult::INVALID_REQUEST;
+        attempts.push_back(refused);
+        return false;
+    }
+
+    if (exactCommitted && buffers.size() == options_.length && ExactInternal::sameOptions(options, options_)) {
+        bool identical = true;
+        for (const auto& buffer : buffers) {
+            const auto gbm = dynamicPointerCast<CGBMBuffer>(buffer);
+            if (!gbm) {
+                identical = false;
+                break;
+            }
+            const auto prior = gbm->exactAllocation();
+            if (prior.result != eExactBufferResult::SUCCESS || !ExactInternal::sameRequest(prior.request, request) ||
+                !ExactInternal::sameOptions(prior.options, options_)) {
+                identical = false;
+                break;
+            }
+        }
+        if (identical)
+            return true; // no allocation or native-call receipt is invented
+    }
+
+    // An unresolved native attempt keeps this one candidate set in custody.
+    // Only whole committed-request reuse above can proceed without cleanup.
+    for (const auto& retained : exactInProgress) {
+        const auto gbm = dynamicPointerCast<CGBMBuffer>(retained);
+        if (!gbm)
+            return false;
+        const auto prior = gbm->exactAllocation();
+        if (prior.create_count > 0 || gbm->bo || std::ranges::any_of(gbm->attrs.fds, [](int fd) { return fd >= 0; }))
+            return false;
+    }
+    exactInProgress.clear(); // CPU-only precondition holders have no native custody
+
+    // Reserve all container/receipt storage before the first native operation.
+    const auto firstCandidate = exactInProgress.size();
+    if (options_.length > exactInProgress.max_size() - firstCandidate)
+        return false;
+    exactInProgress.reserve(firstCandidate + options_.length);
+    attempts.reserve(options_.length);
+    std::vector<SP<IBuffer>> committed;
+    committed.reserve(options_.length);
+    for (size_t i = 0; i < options_.length; ++i) {
+        const auto candidate = SP<CGBMBuffer>(new CGBMBuffer(gbmAllocator));
+        exactInProgress.emplace_back(candidate);
+        const bool initialized = candidate->initializeExact(options_, request, implementation);
+        attempts.emplace_back(candidate->exactAllocation());
+        if (!initialized) {
+            // The copied refusal survives discarding a holder that never
+            // attempted creation and owns neither a BO nor an exported FD.
+            if (attempts.back().create_count == 0 && !candidate->bo &&
+                std::ranges::none_of(candidate->attrs.fds, [](int fd) { return fd >= 0; }))
+                exactInProgress.pop_back();
+            return false;
+        }
+    }
+    for (size_t i = firstCandidate; i < exactInProgress.size(); ++i)
+        committed.emplace_back(std::move(exactInProgress[i]));
+    exactInProgress.resize(firstCandidate);
+    buffers = std::move(committed);
+    options = options_;
+    exactCommitted = true;
+    lastAcquired = 0;
