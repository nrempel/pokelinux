+#pragma once
+
+#include <aquamarine/allocator/Exact.hpp>
+#include <aquamarine/output/Output.hpp>
+#include <cerrno>
+#include <cmath>
+#include <limits>
+#include <sys/stat.h>
+#include <xf86drm.h>
+
+namespace Aquamarine::ExactInternal {
+    inline bool validRequest(const SExactBufferRequest& request) {
+        if (!request.request_id)
+            return false;
+        if (request.mode == eExactBufferMode::IMPLICIT)
+            return request.modifier == 0;
+        return request.mode == eExactBufferMode::EXPLICIT && request.modifier != DRM_FORMAT_MOD_INVALID;
+    }
+
+    inline bool sameRequest(const SExactBufferRequest& a, const SExactBufferRequest& b) {
+        return a.request_id == b.request_id && a.mode == b.mode && a.modifier == b.modifier;
+    }
+
+    inline bool validOptions(const SSwapchainOptions& options) {
+        const auto width = options.size.x, height = options.size.y;
+        return options.length > 0 && options.length <= static_cast<size_t>(std::numeric_limits<int>::max()) &&
+            std::isfinite(width) && std::isfinite(height) && width >= 1 && height >= 1 &&
+            width <= std::numeric_limits<uint32_t>::max() && height <= std::numeric_limits<uint32_t>::max() &&
+            std::floor(width) == width && std::floor(height) == height && options.format != DRM_FORMAT_INVALID &&
+            options.scanout && !options.cursor && !options.multigpu && options.scanoutOutput;
+    }
+
+    inline bool sameOptions(const SSwapchainOptions& a, const SSwapchainOptions& b) {
+        const auto outputA = a.scanoutOutput.lock(), outputB = b.scanoutOutput.lock();
+        return outputA && outputB && outputA == outputB && a.length == b.length && a.size == b.size &&
+            a.format == b.format && a.scanout == b.scanout && a.cursor == b.cursor && a.multigpu == b.multigpu;
+    }
+
+    inline bool bindDevice(int allocatorFd, int kmsFd, SExactDeviceBinding& binding) {
+        binding = {};
+        binding.allocator_fd = allocatorFd;
+        binding.kms_fd = kmsFd;
+        struct stat allocatorStat{}, kmsStat{};
+        const int allocatorStatResult = fstat(allocatorFd, &allocatorStat);
+        const int kmsStatResult = fstat(kmsFd, &kmsStat);
+        if (allocatorStatResult == 0)
+            binding.allocator_rdev = static_cast<uint64_t>(allocatorStat.st_rdev);
+        if (kmsStatResult == 0)
+            binding.kms_rdev = static_cast<uint64_t>(kmsStat.st_rdev);
+
+        drmDevicePtr allocatorDevice = nullptr, kmsDevice = nullptr;
+        binding.allocator_get_device.count = 1;
+        errno = 0;
+        binding.allocator_get_device.result = drmGetDevice2(allocatorFd, 0, &allocatorDevice);
+        const int allocatorError = errno;
+        binding.allocator_get_device.error = binding.allocator_get_device.result == 0 ? 0 : allocatorError;
+        binding.kms_get_device.count = 1;
+        errno = 0;
+        binding.kms_get_device.result = drmGetDevice2(kmsFd, 0, &kmsDevice);
+        const int kmsError = errno;
+        binding.kms_get_device.error = binding.kms_get_device.result == 0 ? 0 : kmsError;
+        if (binding.allocator_get_device.result == 0 && binding.kms_get_device.result == 0 && allocatorDevice && kmsDevice)
+            binding.devices_equal = drmDevicesEqual(allocatorDevice, kmsDevice);
+        if (allocatorDevice)
+            drmFreeDevice(&allocatorDevice);
+        if (kmsDevice)
+            drmFreeDevice(&kmsDevice);
+        return allocatorStatResult == 0 && kmsStatResult == 0 && S_ISCHR(allocatorStat.st_mode) && S_ISCHR(kmsStat.st_mode) &&
+            binding.allocator_get_device.result == 0 && binding.kms_get_device.result == 0 && binding.devices_equal == 1;
+    }
+}
