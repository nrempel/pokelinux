+SP<CDRMFB> Aquamarine::CDRMFB::createExact(SP<IBuffer> source, CWeakPointer<CDRMBackend> target,
+                                          const SExactBufferRequest& request, SExactImport& result) {
+    result = {};
+    result.request = request;
+    if (!ExactInternal::validRequest(request)) {
+        result.result = eExactBufferResult::INVALID_REQUEST;
+        return nullptr;
+    }
+    auto native = dynamicPointerCast<CGBMBuffer>(source);
+    auto owner = target.lock();
+    if (!native || !owner) {
+        result.result = eExactBufferResult::REQUEST_MISMATCH;
+        return nullptr;
+    }
+    const auto allocation = native->exactAllocation();
+    if (allocation.result != eExactBufferResult::SUCCESS || !allocation.buffer_id ||
+        !ExactInternal::sameRequest(allocation.request, request) || !ExactInternal::validOptions(allocation.options) ||
+        allocation.options.scanoutOutput->getBackend().get() != owner.get() || allocation.device.kms_fd != owner->drmFD()) {
+        result.result = eExactBufferResult::REQUEST_MISMATCH;
+        return nullptr;
+    }
+    if (auto attachment = source->attachments.get<CDRMBufferAttachment>()) {
+        auto fb = attachment->fb;
+        if (!fb || !fb->exact || !fb->id || fb->dead || fb->exactCloseAttempted || fb->backend.lock() != owner ||
+            fb->buffer.lock() != source || fb->exactImportFacts.result != eExactBufferResult::SUCCESS ||
+            fb->exactImportFacts.buffer_id != allocation.buffer_id || !ExactInternal::sameRequest(fb->exactImportFacts.request, request)) {
+            result.result = eExactBufferResult::REQUEST_MISMATCH;
+            return nullptr;
+        }
+        result = fb->exactImportFacts;
+        result.reused = true;
+        result.prime_count = 0;
+        result.prime = {};
+        result.addfb = {};
+        return fb;
+    }
+    // Attach the CPU-empty holder before PRIME or framebuffer creation.
+    auto fb = SP<CDRMFB>(new CDRMFB());
+    fb->buffer = source;
+    fb->backend = target;
+    fb->exact = true;
+    fb->exactImportFacts.request = request;
+    fb->exactImportFacts.buffer_id = allocation.buffer_id;
+    source->attachments.add(makeShared<CDRMBufferAttachment>(fb));
+    fb->listeners.destroyBuffer = source->events.destroy.listen([raw = fb.get()] {
+        (void)raw->closeExact();
+        raw->dead = true;
+    });
+    fb->importExact(allocation);
+    result = fb->exactImportFacts;
+    return result.result == eExactBufferResult::SUCCESS ? fb : nullptr;
+}
+
+void Aquamarine::CDRMFB::importExact(const SExactAllocation& allocation) {
+    auto source = buffer.lock();
+    auto owner = backend.lock();
+    auto& receipt = exactImportFacts;
+    receipt.result = eExactBufferResult::NATIVE_FAILURE;
+    if (!source || !owner)
+        return;
+    const auto attrs = source->dmabuf();
+    receipt.exported = attrs;
+    if (!attrs.success || attrs.planes < 1 || attrs.planes > 4 || attrs.size != allocation.options.size ||
+        attrs.format != allocation.options.format || attrs.modifier != allocation.exported.modifier ||
+        attrs.planes != allocation.exported.planes || attrs.fds != allocation.exported.fds ||
+        attrs.offsets != allocation.exported.offsets || attrs.strides != allocation.exported.strides)
+        return;
+    for (int i = 0; i < attrs.planes; ++i)
+        if (attrs.fds[i] < 0 || attrs.strides[i] == 0)
+            return;
+    const int fd = owner->drmFD();
+    if (!ExactInternal::bindDevice(allocation.device.allocator_fd, fd, receipt.device)) {
+        receipt.result = eExactBufferResult::DEVICE_MISMATCH;
+        return;
+    }
+    receipt.modifiers_cap.count = 1;
+    errno = 0;
+    receipt.modifiers_cap.result = drmGetCap(fd, DRM_CAP_ADDFB2_MODIFIERS, &receipt.modifiers_cap_value);
+    const int capError = errno;
+    receipt.modifiers_cap.error = receipt.modifiers_cap.result == 0 ? 0 : capError;
+    if (receipt.modifiers_cap.result != 0)
+        return;
+    const bool explicitMode = receipt.request.mode == eExactBufferMode::EXPLICIT;
+    if (explicitMode && receipt.modifiers_cap_value != 1) {
+        receipt.result = eExactBufferResult::MODIFIERS_UNAVAILABLE;
+        return;
+    }
+    if (explicitMode && attrs.modifier != receipt.request.modifier) {
+        receipt.result = eExactBufferResult::RETURNED_MODIFIER_MISMATCH;
+        return;
+    }
+    for (int i = 0; i < attrs.planes; ++i) {
+        auto& call = receipt.prime[i];
+        ++receipt.prime_count;
+        call.count = 1;
+        errno = 0;
+        call.result = drmPrimeFDToHandle(fd, attrs.fds[i], &boHandles[i]);
+        const int callError = errno;
+        call.error = call.result == 0 ? 0 : callError;
+        receipt.handles[i] = boHandles[i];
+        if (call.result != 0)
+            return; // The attachment retains all earlier handles on failure.
+    }
+    receipt.with_modifiers = explicitMode;
+    receipt.addfb_flags = explicitMode ? DRM_MODE_FB_MODIFIERS : 0;
+    receipt.addfb.count = 1;
+    errno = 0;
+    if (explicitMode) {
+        std::array<uint64_t, 4> modifiers{};
+        std::fill_n(modifiers.begin(), attrs.planes, receipt.request.modifier);
+        receipt.addfb.result = drmModeAddFB2WithModifiers(fd, attrs.size.x, attrs.size.y, attrs.format,
+            boHandles.data(), attrs.strides.data(), attrs.offsets.data(), modifiers.data(), &id, receipt.addfb_flags);
+    } else {
+        receipt.addfb.result = drmModeAddFB2(fd, attrs.size.x, attrs.size.y, attrs.format,
+            boHandles.data(), attrs.strides.data(), attrs.offsets.data(), &id, 0);
+    }
+    const int addError = errno;
+    receipt.addfb.error = receipt.addfb.result == 0 ? 0 : addError;
+    receipt.framebuffer_id = id;
+    if (receipt.addfb.result == 0 && id)
+        receipt.result = eExactBufferResult::SUCCESS;
+}
+
+SExactImport Aquamarine::CDRMFB::exactImport() const {
+    return exactImportFacts;
+}
+
+SExactClose Aquamarine::CDRMFB::closeExact() {
+    if (!exact)
+        return {};
+    if (exactCloseAttempted)
+        return exactCloseFacts;
+    exactCloseAttempted = true;
+    exactCloseFacts.request_id = exactImportFacts.request.request_id;
+    exactCloseFacts.buffer_id = exactImportFacts.buffer_id;
+    exactCloseFacts.framebuffer_id = id;
+    auto owner = backend.lock();
+    if (!owner)
+        return exactCloseFacts; // count0 is unresolved, never a close pass.
+    if (id) {
+        auto& call = exactCloseFacts.closefb;
+        call.count = 1;
+        errno = 0;
+        call.result = drmModeCloseFB(owner->drmFD(), id);
+        const int closeError = errno;
+        call.error = call.result == 0 ? 0 : closeError;
+        if (call.result == 0)
+            id = 0;
+    }
+    closeHandles();
+    dropped = id == 0 && handlesClosed;
+    return exactCloseFacts;
+}
