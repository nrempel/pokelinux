+namespace {
+    // IDs name acquired native allocation occurrences, with permanent refusal
+    // on exhaustion rather than wrapping into a previously issued identity.
+    uint64_t nextExactBufferID() {
+        static std::atomic<uint64_t> next{1};
+        auto value = next.load(std::memory_order_relaxed);
+        while (value != 0) {
+            const auto following = value == std::numeric_limits<uint64_t>::max() ? 0 : value + 1;
+            if (next.compare_exchange_weak(value, following, std::memory_order_relaxed))
+                return value;
+        }
+        return 0;
+    }
