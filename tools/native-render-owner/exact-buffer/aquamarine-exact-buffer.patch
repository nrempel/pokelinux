+        for (int i = 0; i < attrs.planes; ++i) {
+            attrs.strides.at(i) = gbm_bo_get_stride_for_plane(bo, i);
+            attrs.offsets.at(i) = gbm_bo_get_offset(bo, i);
+            attrs.fds.at(i) = gbm_bo_get_fd_for_plane(bo, i);
+            if (attrs.fds.at(i) < 0 || attrs.strides.at(i) == 0) {
+                exported = false;
+                break;
+            }
+        }
+    }
+    attrs.success = exported;
+    exactReceipt.exported = attrs;
+    if (request.mode == eExactBufferMode::EXPLICIT && exactReceipt.raw_modifier != request.modifier) {
+        exactReceipt.result = eExactBufferResult::RETURNED_MODIFIER_MISMATCH;
+        return false;
+    }
+    if (!exported || attrs.size != options_.size || attrs.format != options_.format) {
+        exactReceipt.result = eExactBufferResult::NATIVE_FAILURE;
+        return false;
+    }
+    exactReceipt.result = eExactBufferResult::SUCCESS;
+    return true;
