+// Native byte parsing only: validate the complete tables and every referenced
+// format index before exposing any decoded pair. No route/tuple is selected.
+int32_t copyFormatBlob(SFormatFactsStorage& storage, PrFormatPlaneV1& plane, const drmModePropertyBlobRes& blob) {
+    const auto failed = [&]() {
+        plane.blob_state = PR_FORMAT_READ_ERROR;
+        plane.blob_errno = 0; // malformed bytes have no invented kernel errno
+        plane.blob_length = plane.pair_first = plane.pair_count = 0;
+        return PR_EXECUTOR_OK;
+    };
+    if (!blob.data || blob.length < sizeof(drm_format_modifier_blob) || blob.length > 1024 * 1024)
+        return failed();
+    drm_format_modifier_blob header{};
+    std::memcpy(&header, blob.data, sizeof(header));
+    const auto table = [&](uint32_t offset, uint32_t count, size_t element) {
+        return offset <= blob.length && (count == 0 || (offset >= sizeof(header) && count <= (blob.length - offset) / element));
+    };
+    if (header.version != 1 || header.flags != 0 || !table(header.formats_offset, header.count_formats, sizeof(uint32_t)) ||
+        !table(header.modifiers_offset, header.count_modifiers, sizeof(drm_format_modifier)))
+        return failed();
+    const uint64_t formatEnd = uint64_t(header.formats_offset) + uint64_t(header.count_formats) * sizeof(uint32_t);
+    const uint64_t modifierEnd = uint64_t(header.modifiers_offset) + uint64_t(header.count_modifiers) * sizeof(drm_format_modifier);
+    if (header.count_formats && header.count_modifiers && !(formatEnd <= header.modifiers_offset || modifierEnd <= header.formats_offset))
+        return failed();
+    const auto* bytes = static_cast<const unsigned char*>(blob.data);
+    uint64_t pairCount = 0;
+    for (uint32_t i = 0; i < header.count_modifiers; ++i) {
+        drm_format_modifier modifier{};
+        std::memcpy(&modifier, bytes + header.modifiers_offset + size_t(i) * sizeof(modifier), sizeof(modifier));
+        if (modifier.pad != 0)
+            return failed();
+        for (uint32_t bit = 0; bit < 64; ++bit) {
+            if (!(modifier.formats & (uint64_t(1) << bit))) continue;
+            if (uint64_t(modifier.offset) + bit >= header.count_formats)
+                return failed();
+            ++pairCount;
+        }
+    }
+    if (pairCount > storage.pairs.size() - storage.facts.explicit_pair_count)
+        return PR_EXECUTOR_CAPACITY;
+    const auto first = storage.facts.explicit_pair_count;
+    for (uint32_t i = 0; i < header.count_modifiers; ++i) {
+        drm_format_modifier modifier{};
+        std::memcpy(&modifier, bytes + header.modifiers_offset + size_t(i) * sizeof(modifier), sizeof(modifier));
+        for (uint32_t bit = 0; bit < 64; ++bit) {
+            if (!(modifier.formats & (uint64_t(1) << bit))) continue;
+            uint32_t format = 0;
+            const auto index = size_t(modifier.offset) + bit;
+            std::memcpy(&format, bytes + header.formats_offset + index * sizeof(format), sizeof(format));
+            storage.pairs[storage.facts.explicit_pair_count++] = {format, 0, modifier.modifier};
+        }
+    }
+    plane.pair_first = first;
+    plane.pair_count = storage.facts.explicit_pair_count - first;
+    plane.blob_state = PR_FORMAT_READ_OK;
+    plane.blob_length = blob.length;
+    return PR_EXECUTOR_OK;
+}
