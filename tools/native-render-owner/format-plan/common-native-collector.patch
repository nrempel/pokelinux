+// All arrays are bounded raw observations in native order. They are borrowed
+// only during the synchronous Rust call; no pointer escapes into a plan.
+struct SFormatFactsStorage {
+    PrFormatFactsV2 facts{};
+    std::array<PrFormatNativeV1, PR_FORMAT_MAX_NATIVE_FORMATS> native{};
+    std::array<uint64_t, PR_FORMAT_MAX_MODIFIERS> modifiers{};
+    std::array<PrFormatPlaneV1, PR_FORMAT_MAX_PLANES> planes{};
+    std::array<uint32_t, PR_FORMAT_MAX_LEGACY_FORMATS> legacy{};
+    std::array<PrFormatPairV1, PR_FORMAT_MAX_EXPLICIT_PAIRS> pairs{};
+    std::array<uint32_t, PR_FORMAT_MAX_CRTCS> crtcs{};
+    std::array<uint32_t, PR_FORMAT_MAX_ENCODERS> encoders{};
+
+    void bind() {
+        facts.abi_version = PR_FORMAT_ABI_V2;
+        facts.struct_size = sizeof(facts);
+        facts.native_formats = facts.native_format_count ? native.data() : nullptr;
+        facts.modifiers = facts.modifier_count ? modifiers.data() : nullptr;
+        facts.planes = facts.plane_count ? planes.data() : nullptr;
+        facts.legacy_formats = facts.legacy_format_count ? legacy.data() : nullptr;
+        facts.explicit_pairs = facts.explicit_pair_count ? pairs.data() : nullptr;
+        facts.crtc_ids = facts.crtc_count ? crtcs.data() : nullptr;
+        facts.encoder_possible_crtcs = facts.encoder_count ? encoders.data() : nullptr;
+    }
+};
