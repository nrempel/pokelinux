+
+bool Aquamarine::CBackend::retainNativeChild(const SP<IBackendImplementation>& child) {
+    if (!renderSessionHolder)
+        return true;
+    if (renderOwner != std::this_thread::get_id() || !child || retainedNativeChildCount == retainedNativeChildren.size())
+        return false;
+    retainedNativeChildren[retainedNativeChildCount] = child;
+    ++retainedNativeChildCount;
+    return true;
+}
+
+bool Aquamarine::CBackend::operationalChild(const IBackendImplementation* child) const noexcept {
+    if (!renderSessionHolder)
+        return true;
+    if (renderOwner != std::this_thread::get_id() || !ready || !child)
+        return false;
+    return std::ranges::any_of(implementations, [child](const auto& active) { return active.get() == child; });
+}
+
+bool Aquamarine::CBackend::failRenderStartup() noexcept {
+    if (renderOwner == std::this_thread::get_id() && renderSessionHolder) {
+        ready = false;
+        renderInitialized = false;
+        // These are dispatch references only. Native children remain in the
+        // holder; its caller still needs genuine retirement before destruction.
+        implementations.clear();
+    }
+    return false;
 }
 
