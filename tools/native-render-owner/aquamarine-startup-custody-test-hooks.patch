+struct SDRMCRTC;
+struct SDRMPlane;
+namespace StartupCustodyTest {
+inline constexpr size_t MAX_OUTPUTS = 32, MAX_CRTCS = 32, MAX_PLANES = 128;
+enum class eCase : uint32_t { AFTER_REAL_RESOURCE_SCAN = 1, AFTER_REAL_IMPLEMENTATION_START = 2 };
+struct SProbeStamp {
+    uint64_t boottimeNs = 0, tid = 0;
+    bool valid = false;
+};
+SProbeStamp probeStamp() noexcept;
+
+// Worker-local only: these weak handles and the comparison-only address must
+// NEVER be copied to control/IPC. Main receives Root's copied numeric report.
+// No strong native reference, FD, callback, vector or allocation in this view.
+struct SWeakOutput {
+    Hyprutils::Memory::CWeakPointer<CDRMOutput> output;
+    uint32_t connectorID = 0;
+    uint64_t modeCount = 0;
+};
+struct SWeakGraphView {
+    const CDRMBackend* childIdentity = nullptr; // compare at actual dtor entry only
+    Hyprutils::Memory::CWeakPointer<CDRMBackend> child;
+    Hyprutils::Memory::CWeakPointer<CSessionDevice> device;
+    Hyprutils::Memory::CWeakPointer<CDRMDumbAllocator> dumbAllocator;
+    std::array<SWeakOutput, MAX_OUTPUTS> outputs{};
+    std::array<Hyprutils::Memory::CWeakPointer<SDRMCRTC>, MAX_CRTCS> crtcs{};
+    std::array<Hyprutils::Memory::CWeakPointer<SDRMPlane>, MAX_PLANES> planes{};
+    std::array<uint32_t, MAX_CRTCS> crtcIDs{};
+    std::array<uint32_t, MAX_PLANES> planeIDs{};
+    SProbeStamp stamp{};
+    uint64_t sessionGeneration = 0, deviceLeaseID = 0, deviceGeneration = 0, deviceRdev = 0;
+    uint64_t connectorCount = 0, crtcCount = 0, planeCount = 0;
+    uint32_t capturedOutputCount = 0, capturedCrtcCount = 0, capturedPlaneCount = 0;
+    bool overflow = false, atomic = false, nativeImplementationPresent = false;
+    bool dumbAllocatorPresent = false, primaryAllocatorPresent = false;
+    bool rendererAllocatorPresent = false, rendererPresent = false;
+};
+
+// Actual implementation is Root's retained NativeOwner member on the Rust
+// worker. It may retain SWeakGraphView, never a locked/strong observation ref.
+// Every callback catches exceptions before this noexcept boundary. No control
+// callback, display authorization, native acquisition or destructor in a probe.
+class IProbe {
+  public:
+    IProbe() noexcept = default;
+    virtual ~IProbe() = default;
+    IProbe(const IProbe&) = delete;
+    IProbe& operator=(const IProbe&) = delete;
+    bool onOwnerThread() const noexcept { return owner == std::this_thread::get_id(); }
+    virtual bool afterRealResourceScan(const SWeakGraphView&) noexcept = 0;
+    virtual bool afterRealImplementationStart(const SWeakGraphView&, bool actualResult) noexcept = 0;
+    virtual void childDestructorEntry(const CDRMBackend* identity, SProbeStamp) noexcept = 0;
+  private:
+    const std::thread::id owner = std::this_thread::get_id();
+};
+
+// Borrowed synchronous worker scope; no probe ownership and no hidden strong
+// native ref. Nested/foreign-owner scope shadows the previous scope, inactive.
+class CProbeScope final {
+  public:
+    explicit CProbeScope(IProbe&) noexcept;
+    ~CProbeScope();
+    CProbeScope(const CProbeScope&) = delete;
+    CProbeScope& operator=(const CProbeScope&) = delete;
+    bool bound() const noexcept;
+    static IProbe* current() noexcept;
+  private:
+    const std::thread::id owner = std::this_thread::get_id();
+    IProbe* probe = nullptr;
+    CProbeScope* previous = nullptr;
+    bool installed = false;
+};
+bool forceAfterResourceScan(const SWeakGraphView&) noexcept;
+bool forceAfterImplementationStart(const SWeakGraphView&, bool actualResult) noexcept;
+void observeChildDestructorEntry(const CDRMBackend*) noexcept;
+} // namespace StartupCustodyTest
+} // namespace Aquamarine
+#endif
