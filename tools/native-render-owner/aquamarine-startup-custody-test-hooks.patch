+Aquamarine::StartupCustodyTest::SWeakGraphView Aquamarine::CDRMBackend::startupCustodyView(bool primaryAllocatorPresent) const noexcept {
+    using namespace Aquamarine::StartupCustodyTest;
+    SWeakGraphView view{};
+    view.childIdentity = this;
+    view.child = self;
+    view.device = gpu;
+    view.dumbAllocator = dumbAllocator;
+    view.stamp = probeStamp();
+    view.atomic = atomic;
+    view.nativeImplementationPresent = !!impl;
+    view.primaryAllocatorPresent = primaryAllocatorPresent;
+    view.dumbAllocatorPresent = !!dumbAllocator;
+    view.rendererAllocatorPresent = !!rendererState.allocator;
+    view.rendererPresent = !!rendererState.renderer;
+    if (gpu) {
+        view.sessionGeneration = gpu->sessionGenerationTag;
+        view.deviceLeaseID = gpu->leaseID;
+        view.deviceGeneration = gpu->generation;
+        view.deviceRdev = static_cast<uint64_t>(gpu->dev);
+    }
+    view.connectorCount = connectors.size();
+    view.crtcCount = crtcs.size();
+    view.planeCount = planes.size();
+    view.overflow = connectors.size() > MAX_OUTPUTS || crtcs.size() > MAX_CRTCS || planes.size() > MAX_PLANES;
+    for (size_t i = 0; i < connectors.size() && i < MAX_OUTPUTS; ++i) {
+        const auto& connector = connectors[i];
+        if (!connector || !connector->output)
+            continue;
+        auto& output = view.outputs[view.capturedOutputCount++];
+        output.output = connector->output;
+        output.connectorID = connector->id;
+        output.modeCount = connector->output->modes.size();
+    }
+    for (size_t i = 0; i < crtcs.size() && i < MAX_CRTCS; ++i) {
+        view.crtcs[i] = crtcs[i];
+        view.crtcIDs[i] = crtcs[i] ? crtcs[i]->id : 0;
+        ++view.capturedCrtcCount;
+    }
+    for (size_t i = 0; i < planes.size() && i < MAX_PLANES; ++i) {
+        view.planes[i] = planes[i];
+        view.planeIDs[i] = planes[i] ? planes[i]->id : 0;
+        ++view.capturedPlaneCount;
+    }
+    return view; // only weak refs; no lock()/new native holder/FD acquisition
+}
+#endif
