diff --git a/src/backend/StartupCustodyTest.cpp b/src/backend/StartupCustodyTest.cpp
new file mode 100644
--- /dev/null
+++ b/src/backend/StartupCustodyTest.cpp
@@ -0,0 +1,60 @@
+#include <aquamarine/backend/StartupCustodyTest.hpp>
+#ifdef POKELINUX_STARTUP_CUSTODY_TEST
+#include <cerrno>
+#include <ctime>
+#include <exception>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+using namespace Aquamarine::StartupCustodyTest;
+namespace { thread_local CProbeScope* currentScope = nullptr; }
+SProbeStamp Aquamarine::StartupCustodyTest::probeStamp() noexcept {
+    const int savedErrno = errno;
+    timespec now{};
+    SProbeStamp result{};
+    const auto tid = ::syscall(SYS_gettid);
+    if (::clock_gettime(CLOCK_BOOTTIME, &now) == 0 && now.tv_sec >= 0 && now.tv_nsec >= 0 &&
+        now.tv_nsec < 1000000000L && tid > 0) {
+        result.boottimeNs = static_cast<uint64_t>(now.tv_sec) * 1000000000ULL + static_cast<uint64_t>(now.tv_nsec);
+        result.tid = static_cast<uint64_t>(tid);
+        result.valid = true;
+    }
+    errno = savedErrno;
+    return result;
+}
+CProbeScope::CProbeScope(IProbe& value) noexcept : probe(&value), previous(currentScope) {
+    installed = !previous && value.onOwnerThread();
+    currentScope = this;
+}
+CProbeScope::~CProbeScope() {
+    if (owner != std::this_thread::get_id() || currentScope != this)
+        std::terminate();
+    currentScope = previous;
+}
+bool CProbeScope::bound() const noexcept {
+    return installed && owner == std::this_thread::get_id() && probe && probe->onOwnerThread();
+}
+IProbe* CProbeScope::current() noexcept {
+    return currentScope && currentScope->bound() ? currentScope->probe : nullptr;
+}
+bool Aquamarine::StartupCustodyTest::forceAfterResourceScan(const SWeakGraphView& view) noexcept {
+    const int savedErrno = errno;
+    auto* probe = CProbeScope::current();
+    const bool force = probe && probe->afterRealResourceScan(view);
+    errno = savedErrno;
+    return force;
+}
+bool Aquamarine::StartupCustodyTest::forceAfterImplementationStart(const SWeakGraphView& view, bool actualResult) noexcept {
+    const int savedErrno = errno;
+    auto* probe = CProbeScope::current();
+    const bool requested = probe && probe->afterRealImplementationStart(view, actualResult);
+    errno = savedErrno;
+    return actualResult && requested; // a false real start is never the selected injection
+}
+void Aquamarine::StartupCustodyTest::observeChildDestructorEntry(const Aquamarine::CDRMBackend* child) noexcept {
+    const int savedErrno = errno;
+    if (auto* probe = CProbeScope::current())
+        probe->childDestructorEntry(child, probeStamp());
+    errno = savedErrno;
+}
+#endif
