+// These queries only corroborate native registry facts. They neither select a
+// display route nor mint a recovery epoch/capability generation.
+struct SObservationFailure { const char* reason; int error; uint32_t connector; };
+void requireObservation(bool valid, const char* reason, uint32_t connector, int error = 0) {
+    if (!valid) throw SObservationFailure{reason, error, connector};
+}
+template<auto Free, class T> auto drmOwned(T* value) {
+    return std::unique_ptr<T, decltype(Free)>(value, Free);
+}
+bool sameMode(const drmModeModeInfo& a, const drmModeModeInfo& b) {
+    return a.clock == b.clock && a.hdisplay == b.hdisplay && a.hsync_start == b.hsync_start && a.hsync_end == b.hsync_end &&
+        a.htotal == b.htotal && a.hskew == b.hskew && a.vdisplay == b.vdisplay && a.vsync_start == b.vsync_start &&
+        a.vsync_end == b.vsync_end && a.vtotal == b.vtotal && a.vscan == b.vscan && a.vrefresh == b.vrefresh &&
+        a.flags == b.flags && a.type == b.type && std::strncmp(a.name, b.name, sizeof(a.name)) == 0;
+}
+uint32_t modeRefresh(const drmModeModeInfo& mode) {
+    if (!mode.htotal || !mode.vtotal) return 0;
+    int64_t refresh = (int64_t(mode.clock) * 1000000 / mode.htotal + mode.vtotal / 2) / mode.vtotal;
+    if (mode.flags & DRM_MODE_FLAG_INTERLACE) refresh *= 2;
+    if (mode.flags & DRM_MODE_FLAG_DBLSCAN) refresh /= 2;
+    if (mode.vscan > 1) refresh /= mode.vscan;
+    return refresh > 0 && refresh <= std::numeric_limits<uint32_t>::max() ? uint32_t(refresh) : 0;
+}
+void corroborateFormat(int fd, const drmModeRes& resources, const drmModeConnector& connector, uint32_t format, uint64_t modifier) {
+    const auto id = connector.connector_id;
+    requireObservation(resources.count_crtcs > 0 && resources.count_crtcs <= 32 && connector.count_encoders > 0 &&
+        connector.count_encoders <= int(PR_EXECUTOR_MAX_OBJECTS), "encoder-bounds", id);
+    uint32_t compatible = 0;
+    for (int i = 0; i < connector.count_encoders; ++i) {
+        auto encoder = drmOwned<drmModeFreeEncoder>(drmModeGetEncoder(fd, connector.encoders[i]));
+        requireObservation(!!encoder, "get-encoder", id, errno);
+        compatible |= encoder->possible_crtcs;
+    }
+    if (connector.encoder_id) {
+        auto encoder = drmOwned<drmModeFreeEncoder>(drmModeGetEncoder(fd, connector.encoder_id));
+        requireObservation(!!encoder, "get-current-encoder", id, errno);
+        if (encoder->crtc_id) {
+            uint32_t current = 0;
+            for (int i = 0; i < resources.count_crtcs; ++i)
+                if (resources.crtcs[i] == encoder->crtc_id) current = uint32_t(1) << i;
+            requireObservation(current && (compatible & current), "current-crtc", id);
+            compatible = current;
+        }
+    }
+    requireObservation(compatible != 0, "no-compatible-crtc", id);
+    auto planes = drmOwned<drmModeFreePlaneResources>(drmModeGetPlaneResources(fd));
+    requireObservation(!!planes, "get-planes", id, errno);
+    requireObservation(planes->count_planes > 0 && planes->count_planes <= PR_EXECUTOR_MAX_OBJECTS, "plane-bounds", id);
+    for (uint32_t i = 0; i < planes->count_planes; ++i) {
+        auto plane = drmOwned<drmModeFreePlane>(drmModeGetPlane(fd, planes->planes[i]));
+        requireObservation(!!plane, "get-plane", id, errno);
+        if (!(plane->possible_crtcs & compatible)) continue;
+        requireObservation(plane->count_formats <= 4096, "format-bounds", id);
+        bool hasFormat = false;
+        for (uint32_t j = 0; j < plane->count_formats; ++j) hasFormat |= plane->formats[j] == format;
+        if (!hasFormat) continue;
+        auto properties = drmOwned<drmModeFreeObjectProperties>(drmModeObjectGetProperties(fd, plane->plane_id, DRM_MODE_OBJECT_PLANE));
+        requireObservation(!!properties, "get-plane-properties", id, errno);
+        requireObservation(properties->count_props <= PR_EXECUTOR_MAX_OBJECTS, "plane-property-bounds", id);
+        bool primary = false;
+        uint64_t blobID = 0;
+        for (uint32_t j = 0; j < properties->count_props; ++j) {
+            auto property = drmOwned<drmModeFreeProperty>(drmModeGetProperty(fd, properties->props[j]));
+            requireObservation(!!property, "get-plane-property", id, errno);
+            if (std::strcmp(property->name, "type") == 0) primary = properties->prop_values[j] == DRM_PLANE_TYPE_PRIMARY;
+            if (std::strcmp(property->name, "IN_FORMATS") == 0) blobID = properties->prop_values[j];
+        }
+        if (!primary || !blobID) continue; // No implicit modifier capability fallback.
+        requireObservation(blobID <= std::numeric_limits<uint32_t>::max(), "format-blob-id", id);
+        auto blob = drmOwned<drmModeFreePropertyBlob>(drmModeGetPropertyBlob(fd, uint32_t(blobID)));
+        requireObservation(!!blob, "get-format-blob", id, errno);
+        requireObservation(blob->length > 0 && blob->length <= 1024 * 1024, "format-blob-bounds", id);
+        drmModeFormatModifierIterator iterator{};
+        while (drmModeFormatModifierBlobIterNext(blob.get(), &iterator))
+            if (iterator.fmt == format && iterator.mod == modifier) return;
+    }
+    throw SObservationFailure{"primary-format-modifier-unavailable", 0, id};
+}
+PrDiscoveryV1 freshDiscovery(SNativeOwner& owner, uint64_t session) {
+    requireObservation(owner.mirror && owner.backend && owner.mirror->initialEnumerationComplete() && owner.mirror->active &&
+        !owner.outputFailure, "native-registry-unavailable", 0);
+    PrDiscoveryV1 result{};
+    result.session_generation = session;
+    for (uint32_t i = 0; i < owner.outputCount; ++i) {
+        const auto& entry = owner.outputs[i];
+        if (!entry.live) continue; // Retain the destroyed object's custody; never publish it.
+        const auto id = entry.values.connector_id;
+        auto implementation = entry.output->getBackend();
+        auto drm = Hyprutils::Memory::dynamicPointerCast<CDRMOutput>(entry.output);
+        requireObservation(implementation && implementation->type() == AQ_BACKEND_DRM && drm &&
+            drm->getConnectorID() > 0 && uint32_t(drm->getConnectorID()) == id, "native-output-identity", id);
+        const int fd = implementation->drmFD();
+        struct stat identity{};
+        const int statResult = fd >= 0 ? fstat(fd, &identity) : -1;
+        requireObservation(statResult == 0 && S_ISCHR(identity.st_mode), "native-device-fstat", id, statResult < 0 ? (fd < 0 ? EBADF : errno) : 0);
+        bool deviceFound = false;
+        for (const auto& device : owner.mirror->sessionDevices)
+            deviceFound |= device && !device->retiring && device->fd == fd && device->dev == identity.st_rdev &&
+                device->leaseID == entry.values.device_lease_id && device->generation == entry.values.device_generation;
+        requireObservation(deviceFound, "native-device-generation", id);
+        auto resources = drmOwned<drmModeFreeResources>(drmModeGetResources(fd));
+        requireObservation(!!resources, "get-resources", id, errno);
+        requireObservation(resources->count_connectors > 0 && resources->count_connectors <= int(PR_EXECUTOR_MAX_OUTPUTS), "connector-bounds", id);
+        bool foundConnector = false;
+        for (int j = 0; j < resources->count_connectors; ++j) {
+            auto current = drmOwned<drmModeFreeConnector>(drmModeGetConnectorCurrent(fd, resources->connectors[j]));
+            requireObservation(!!current, "get-current-connector", resources->connectors[j], errno);
+            if (current->connector_id == id) foundConnector = true;
+            if (current->connection != DRM_MODE_CONNECTED || current->count_modes == 0) continue;
+            bool represented = false;
+            for (uint32_t k = 0; k < owner.outputCount; ++k) {
+                const auto& actual = owner.outputs[k];
+                represented |= actual.live && actual.values.connector_id == current->connector_id &&
+                    actual.values.device_lease_id == entry.values.device_lease_id && actual.values.device_generation == entry.values.device_generation;
+            }
+            requireObservation(represented, "kernel-connector-missing-native-output", current->connector_id);
+        }
+        requireObservation(foundConnector, "native-connector-missing-kernel", id);
+        auto connector = drmOwned<drmModeFreeConnector>(drmModeGetConnectorCurrent(fd, id));
+        requireObservation(!!connector, "get-selected-connector", id, errno);
+        requireObservation(connector->connection == DRM_MODE_CONNECTED && connector->count_modes > 0 && connector->count_modes <= 4096,
+            "connected-mode-bounds", id);
+        requireObservation(connector->count_props >= 0 && connector->count_props <= int(PR_EXECUTOR_MAX_OBJECTS), "connector-property-bounds", id);
+        bool nonDesktopObserved = false;
+        for (int j = 0; j < connector->count_props; ++j) {
+            auto property = drmOwned<drmModeFreeProperty>(drmModeGetProperty(fd, connector->props[j]));
+            requireObservation(!!property, "get-connector-property", id, errno);
+            if (std::strcmp(property->name, "non-desktop") == 0) {
+                requireObservation(connector->prop_values[j] <= 1 && bool(connector->prop_values[j]) == entry.output->nonDesktop,
+                    "kernel-non-desktop-mismatch", id);
+                nonDesktopObserved = true;
+            }
+        }
+        requireObservation(nonDesktopObserved, "non-desktop-property-unavailable", id);
+        const drmModeModeInfo* preferred = nullptr;
+        for (int j = 0; j < connector->count_modes; ++j)
+            if (!(connector->modes[j].flags & DRM_MODE_FLAG_INTERLACE) && (connector->modes[j].type & DRM_MODE_TYPE_PREFERRED)) {
+                preferred = &connector->modes[j]; break;
+            }
+        // Keep the actual retained registry mode identity. A stale AQ preferred
+        // cache cannot qualify fresh kernel timings/flags/selection.
+        const auto mode = entry.output->preferredMode();
+        requireObservation(mode && mode == entry.mode && mode->modeInfo && preferred && mode->preferred &&
+            sameMode(*mode->modeInfo, *preferred) && mode->pixelSize.x == preferred->hdisplay && mode->pixelSize.y == preferred->vdisplay &&
+            mode->refreshRate == modeRefresh(*preferred), "kernel-preferred-mode-mismatch", id);
+        auto value = entry.values;
+        value.width = preferred->hdisplay;
+        value.height = preferred->vdisplay;
+        value.refresh_millihz = modeRefresh(*preferred);
+        const auto formats = entry.output->getRenderFormats();
+        requireObservation(!formats.empty() && !formats.front().modifiers.empty(), "native-format-unavailable", id);
+        value.drm_format = formats.front().drmFormat;
+        value.modifier = formats.front().modifiers.front();
+        corroborateFormat(fd, *resources, *connector, value.drm_format, value.modifier);
+        value.flags = entry.output->nonDesktop ? 1u : 0u;
+        result.outputs[result.output_count++] = value;
+    }
+    requireObservation(result.output_count > 0, "no-live-native-outputs", 0);
+    return result;
+}
+int32_t applyDeviceChangeNative(void* opaque, const PrSessionRenderEventV1* event, PrDiscoveryV1* result) noexcept {
+    try {
+        if (!opaque || !event || !result) return PR_EXECUTOR_INVALID;
+        auto& owner = *static_cast<SNativeOwner*>(opaque);
+        if (owner.thread != std::this_thread::get_id() || !owner.mirror || !owner.backend || event->event_type != 5)
+            return PR_EXECUTOR_PROTOCOL;
+        CDisplayAttemptScope guard(eDisplayAttemptDomain::RENDER, denyDisplay, &owner);
+        const auto applied = owner.mirror->applyRenderEvent(copyEvent(*event), -1, -1);
+        requireObservation(applied == eSessionApply::APPLIED_METADATA, "mirror-apply-change", event->connector_id);
+        requireObservation(noDisplayRequest(guard), "display-request-during-change", event->connector_id);
+        const auto candidate = freshDiscovery(owner, event->session_generation);
+        requireObservation(noDisplayRequest(guard), "display-request-during-query", event->connector_id);
+        *result = candidate;
+        return PR_EXECUTOR_OK;
+    } catch (const SObservationFailure& failure) {
+        try { Log::logger->log(Log::ERR, "owned-device-change: {} errno={} connector={}", failure.reason, failure.error, failure.connector); } catch (...) {}
+        return PR_EXECUTOR_NATIVE;
+    } catch (...) {
+        try { Log::logger->log(Log::ERR, "owned-device-change: native-query-exception"); } catch (...) {}
+        return PR_EXECUTOR_NATIVE;
+    }
+}
