+ auto* scan=udev_enumerate_new(udevHandle);if(!scan){failRenderTransport();return;}
+ udev_enumerate_add_match_subsystem(scan,"drm");udev_enumerate_add_match_sysname(scan,"card[0-9]*");
+ if(udev_enumerate_scan_devices(scan)){udev_enumerate_unref(scan);failRenderTransport();return;}
+ udev_list_entry* entry=nullptr;
+ udev_list_entry_foreach(entry,udev_enumerate_get_list_entry(scan)){
+  auto* device=udev_device_new_from_syspath(udevHandle,udev_list_entry_get_name(entry));
+  if(device){addGraphicsDevice(device);udev_device_unref(device);}if(failed)break;
+ }
+ udev_enumerate_unref(scan);
