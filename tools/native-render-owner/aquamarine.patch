+ if(!isInputBroker()||!onOwnerThread())return false;
+ lastRevocation=inputOptions.revokeRender?inputOptions.revokeRender(inputOptions.controlContext,sessionGeneration,reason):AQ_REVOKE_UNAVAILABLE;
