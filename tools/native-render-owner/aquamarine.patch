+#pragma once
+#include <cstdint>
+#include <cstddef>
+#include <type_traits>
+namespace Aquamarine {
+inline constexpr uint32_t AQ_SESSION_EVENT_VERSION=1;
+inline constexpr size_t AQ_SESSION_MAX_DEVICE_LEASES=32, AQ_SESSION_MAX_PENDING_EVENTS=128;
+enum eSessionRenderEvent : uint32_t { AQ_SESSION_INIT=1, AQ_SESSION_DEVICE_ADD=2, AQ_SESSION_ENUMERATION_DONE=3,
+    AQ_SESSION_ACTIVE=4, AQ_SESSION_DEVICE_CHANGE=5, AQ_SESSION_DEVICE_REMOVE=6, AQ_SESSION_SHUTDOWN=7 };
+// Copied metadata only. FD arguments are separate owned capabilities at apply.
+struct SSessionRenderEvent {
+    uint32_t version=1,type=0;
+    uint64_t session_sequence=0,session_generation=0,device_lease_id=0,device_generation=0,rdev=0;
+    uint32_t active=0,vt=0,change_type=0,connector_id=0,prop_id=0,boot_vga=0,reserved[4]{};
+    char seat_name[64]{},device_path[256]{};
+};
+static_assert(std::is_standard_layout_v<SSessionRenderEvent> && std::is_trivially_copyable_v<SSessionRenderEvent>);
+static_assert(sizeof(SSessionRenderEvent)==408 && offsetof(SSessionRenderEvent,reserved)==72 && offsetof(SSessionRenderEvent,seat_name)==88 && offsetof(SSessionRenderEvent,device_path)==152);
+struct SSessionPendingEvent { SSessionRenderEvent metadata; int primary_fd=-1,render_fd=-1; }; // borrowed, never consumed by peek
+struct SSessionDeviceFDClosed {
+    uint64_t session_generation=0,device_lease_id=0,device_generation=0,remove_sequence=0;
+};
+// Different type: Root may construct this only from the actual owner aggregate
+// after outputs/GL/allocator/GBM descendants AND the mirrored device are retired.
+struct SSessionDeviceRetired {
+    uint64_t session_generation=0,device_lease_id=0,device_generation=0,remove_sequence=0;
+};
+// The FDClosed type is a device-FD fact, NOT full graphics retirement: the owner adapter must
+// also drain every output/GL/allocator/GBM descendant before acknowledging a lease.
+enum class eSessionApply : uint32_t { APPLIED_METADATA=0, WRONG_OWNER, INVALID, CAPACITY, TERMINAL };
+}
