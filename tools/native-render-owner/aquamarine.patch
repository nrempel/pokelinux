+void CSession::brokerSeatChanged(bool enabled){
+ if(!isInputBroker()||!onOwnerThread())return;
+ if(!enabled)revokeForControl(AQ_REVOKE_DISABLE); // before ANY queued event or seat ack, even failed/full
+ active=enabled&&!failed&&!shuttingDown;
+ if(libinputHandle){if(active){if(libinput_resume(libinputHandle)<0)failRenderTransport();else dispatchLibinputEvents();}else libinput_suspend(libinputHandle);}
