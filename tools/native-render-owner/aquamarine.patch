+#pragma once
+#include <cstdint>
+#include <array>
+#include <cstddef>
+#include <thread>
+#include <cerrno>
+namespace Aquamarine {
+enum class eDisplayAttemptDomain:uint32_t { RENDER=1, STOP_RETIRE=2 };
+enum class eDisplayAttemptKind:uint32_t { ATOMIC=1, EXTERNAL_LEASE_CREATE=2 };
+inline constexpr size_t AQ_MAX_DISPLAY_OBJECTS=128;
+struct SDisplayAttemptInfo {
+    uint32_t kind=0,domain=0,flags=0,connector_id=0; int32_t drm_fd=-1; uint32_t object_count=0;
+    uint64_t session_generation=0,device_lease_id=0,device_generation=0;
+    std::array<uint32_t,AQ_MAX_DISPLAY_OBJECTS> object_ids{};
+    // Actual private request object IDs, not invented output generations. The
+    // synchronous owner bridge must resolve EVERY ID through its genuine live
+    // device/output generation table and authenticate the whole effect scope.
+};
+struct SDisplayAttemptResult { SDisplayAttemptInfo info{}; bool sealed=false,attempted=false,additional_refused=false; int32_t result=0,error=0; };
+class CDisplayAttemptScope {
+ public:
+    using SealFn=uint32_t(*)(void*,const SDisplayAttemptInfo*) noexcept;
+    CDisplayAttemptScope(eDisplayAttemptDomain domain,SealFn seal,void* ownerLocalStackToken) noexcept;
+    ~CDisplayAttemptScope();
+    CDisplayAttemptScope(const CDisplayAttemptScope&)=delete;
+    CDisplayAttemptScope& operator=(const CDisplayAttemptScope&)=delete;
+    bool bound() const noexcept;
+    const SDisplayAttemptResult& result() const noexcept;
+    static bool authorize(const SDisplayAttemptInfo&) noexcept;
+    static void returned(int result,int error) noexcept;
+ private:
+    const std::thread::id owner=std::this_thread::get_id();
+    eDisplayAttemptDomain domain;
+    SealFn seal=nullptr;
+    void* token=nullptr; // borrowed only for this synchronous owner stack scope
+    CDisplayAttemptScope* previous=nullptr;
+    bool installed=false,consumed=false;
+    SDisplayAttemptResult record;
+};
+template<class Call> int displayChangingCall(const SDisplayAttemptInfo& info,Call&& call) {
+    if(!CDisplayAttemptScope::authorize(info)){errno=EPERM;return -1;}
+    const int value=call();const int error=errno;CDisplayAttemptScope::returned(value,error);errno=error;return value;
+}
+}
