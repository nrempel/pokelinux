+#include <aquamarine/backend/DisplayAttempt.hpp>
+#include <exception>
+#include <algorithm>
+using namespace Aquamarine;
+namespace { thread_local CDisplayAttemptScope* current=nullptr; }
+CDisplayAttemptScope::CDisplayAttemptScope(eDisplayAttemptDomain value,SealFn fn,void* stackToken) noexcept:domain(value),seal(fn),token(stackToken){
+ previous=current;
+ installed=!previous&&seal&&token&&(domain==eDisplayAttemptDomain::RENDER||domain==eDisplayAttemptDomain::STOP_RETIRE);
+ current=this; // even invalid/nested scopes shadow the outer capability and fail closed
+}
+CDisplayAttemptScope::~CDisplayAttemptScope(){if(owner!=std::this_thread::get_id()||current!=this)std::terminate();current=previous;}
+bool CDisplayAttemptScope::bound() const noexcept{return installed&&owner==std::this_thread::get_id();}
+const SDisplayAttemptResult& CDisplayAttemptScope::result() const noexcept{return record;}
+bool CDisplayAttemptScope::authorize(const SDisplayAttemptInfo& info) noexcept{
+ if(!current||!current->bound())return false;
+ auto& self=*current;if(self.consumed){self.record.additional_refused=true;return false;}
+ self.consumed=true;self.record.info=info;self.record.info.domain=static_cast<uint32_t>(self.domain);
+ if((info.kind!=static_cast<uint32_t>(eDisplayAttemptKind::ATOMIC)&&info.kind!=static_cast<uint32_t>(eDisplayAttemptKind::EXTERNAL_LEASE_CREATE))||
+    info.drm_fd<0||!info.session_generation||!info.device_lease_id||!info.device_generation||!info.object_count||info.object_count>info.object_ids.size())return false;
+ for(size_t i=0;i<info.object_count;++i){if(!info.object_ids[i])return false;for(size_t j=0;j<i;++j)if(info.object_ids[j]==info.object_ids[i])return false;}
+ for(size_t i=info.object_count;i<info.object_ids.size();++i)if(info.object_ids[i])return false;
+ self.record.sealed=self.seal(self.token,&self.record.info)==1;return self.record.sealed;
+}
+void CDisplayAttemptScope::returned(int result,int error) noexcept{if(current&&current->record.sealed){current->record.attempted=true;current->record.result=result;current->record.error=error;}}
