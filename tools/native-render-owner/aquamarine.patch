+void CSession::failRenderTransport() noexcept{
+ if(!isInputBroker()||!onOwnerThread()||failed)return;
+ failed=true;active=false;failureNotificationPending=true;
+ revokeForControl(AQ_REVOKE_TRANSPORT_FAILURE);
+ try{if(libinputHandle)libinput_suspend(libinputHandle);}catch(...){/* terminal state/revocation already retained */}
+ // No graphics call, queue wait, false retirement or listener before seat ack.
