+bool CSession::enqueueRenderEvent(SSessionRenderEvent event,int primary,int render){
+ OwnedFD p{primary},r{render};
+ if(!isInputBroker()||!onOwnerThread()||failed||pendingCount==pending.size()||nextSequence==std::numeric_limits<uint64_t>::max()){failRenderTransport();return false;}
+ event.session_sequence=nextSequence++;
+ auto& out=pending[(pendingHead+pendingCount)%pending.size()];out.event=event;out.primary=p.release();out.render=r.release();++pendingCount;return true;
+}
+std::optional<SSessionPendingEvent> CSession::peekPendingRenderEvent()const{
+ if(!isInputBroker()||!onOwnerThread()||failed||!pendingCount)return {};
+ const auto& p=pending[pendingHead];return SSessionPendingEvent{p.event,p.primary,p.render};
