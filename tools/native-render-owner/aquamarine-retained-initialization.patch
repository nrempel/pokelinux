+SP<CBackend> CBackend::createRenderSessionHolder(const SBackendOptions& options, SP<CSession> mirror) {
+    if (!mirror || !mirror->isRenderMirror() || !mirror->onOwnerThread() || !mirror->initialEnumerationComplete())
+        return nullptr;
+    auto holder = SP<CBackend>(new CBackend()); // Empty CPU holder, no native acquisition.
+    holder->self = holder;
+    holder->session = mirror;
+    holder->options = options;
+    holder->renderSessionHolder = true;
+    SBackendImplementationOptions drm;
+    drm.backendType = AQ_BACKEND_DRM;
+    drm.backendRequestMode = AQ_BACKEND_REQUEST_MANDATORY;
+    holder->implementationOptions = {drm};
+    if (!mirror->bindRenderBackend(holder))
+        return nullptr;
+    return holder;
+}
+
+bool CBackend::initializeRenderSession() {
+    if (!renderSessionHolder || renderInitializationAttempted || renderOwner != std::this_thread::get_id() ||
+        !session || !session->onOwnerThread() || !session->initialEnumerationComplete() || !session->active)
+        return false;
+    renderInitializationAttempted = true; // No implicit retry after any native work.
+    logger = Hyprutils::Memory::makeShared<CLogger>();
+    logger->m_loggerConnection = options.logConnection;
+    logger->m_logFn = options.logFunction;
+    logger->updateLevels();
+    implementations.reserve(session->sessionDevices.size());
+    // The caller retains this outer holder before entering here. Actual child
+    // failure custody is the NEXT separate behavioral RED/repair boundary.
+    const auto initialized = CDRMBackend::attempt(self.lock());
+    for (const auto& child : initialized)
+        implementations.emplace_back(child);
+    idle.fd = timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC);
+    renderInitialized = !implementations.empty() && idle.fd >= 0;
+    return renderInitialized;
 }
