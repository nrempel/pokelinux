{
  "runtime": "/run/pokelinux/session",
  "policy": "/var/lib/pokelinux/session",
  "profiles": "/etc/pokelinux/apps.json",
  "app_entry": "/usr/libexec/pokelinux/pokelinux-session-owner",
  "display_parent": "/run/pokelinux/displays",
  "wayland": "/run/user/1000/wayland-1",
  "audio_socket": "/run/pokelinux-audio/audio.sock",
  "appearance_socket": "/run/pokelinux/appearance.sock",
  "messages": {
    "mode": "disabled"
  },
  "brightness": {
    "mode": "disabled"
  },
  "connectivity": {
    "mode": "owner",
    "socket": "/run/pokelinux-connectivity/control.sock"
  },
  "compositor_executable": "/usr/bin/Hyprland",
  "compositor_config": "/etc/pokelinux/normal-hypr.lua",
  "environment": {
    "HOME": "/home/alarm",
    "XDG_RUNTIME_DIR": "/run/user/1000",
    "PATH": "/usr/bin",
    "LANG": "C.UTF-8",
    "XDG_SESSION_TYPE": "wayland",
    "XDG_CURRENT_DESKTOP": "Hyprland",
    "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/user/1000/bus",
    "POKELINUX_DISPLAY_PROFILE": "/usr/share/pokelinux/display-fixture/pixel10.json",
    "POKELINUX_DISPLAY_PROFILE_RECEIPT": "/run/user/1000/pixel10-profile/applied.json"
  }
}
