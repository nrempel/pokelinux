+    template<class Renderer, class Window, class Fadeout>
+    void visitFullscreen(Renderer& renderer, PHLMONITOR pMonitor, PHLWORKSPACE pWorkspace, const Time::steady_tp& time, Window&& window, Fadeout&& fadeout) {
+        PHLWINDOW pWorkspaceWindow = nullptr;
+
+        // pre-filter renderable windows once for the tiled + floating passes
+        std::vector<PHLWINDOW> windows;
+        windows.reserve(Desktop::windowState()->windows().size());
+        for (auto const& w : Desktop::windowState()->windows()) {
+            if (!renderer.shouldRenderWindow(w, pMonitor))
+                continue;
+
+            if (w->alphaValue(Desktop::View::WINDOW_ALPHA_FADE) * w->alphaValue(Desktop::View::WINDOW_ALPHA_FULLSCREEN) == 0.f)
+                continue;
+
+            if (Fullscreen::controller()->isFullscreen(w))
+                continue;
+
+            windows.emplace_back(w);
+        }
+
+        // tiled windows that are fading out
+        for (auto const& w : windows) {
+            if (w->m_isFloating)
+                continue;
+
+            if (pWorkspace->m_isSpecialWorkspace != w->onSpecialWorkspace())
+                continue;
+
+            window(w, pMonitor, time, true, RENDER_PASS_ALL);
+        }
+        fadeout(pMonitor, Desktop::FADEOUT_PLANE_WINDOW_TILED, pWorkspace);
+
+        // and floating ones too
+        for (auto const& w : windows) {
+            if (!w->m_isFloating)
+                continue;
+
+            if (w->m_monitor == pWorkspace->m_monitor && pWorkspace->m_isSpecialWorkspace != w->onSpecialWorkspace())
+                continue;
+
+            if (pWorkspace->m_isSpecialWorkspace && w->m_monitor != pWorkspace->m_monitor)
+                continue; // special on another are rendered as a part of the base pass
+
+            if (w->isFadingOutUnderFullscreen())
+                continue; // render these over fullscreen so the fade-out is visible
+
+            window(w, pMonitor, time, true, RENDER_PASS_ALL);
+        }
+        fadeout(pMonitor, Desktop::FADEOUT_PLANE_WINDOW_FLOATING, pWorkspace);
+
+        // TODO: this pass sucks
+        for (auto const& w : Desktop::windowState()->windows()) {
+            const auto PWORKSPACE = w->m_workspace;
+
+            if (w->m_workspace != pWorkspace || !Fullscreen::controller()->isFullscreen(w)) {
+                if (!(PWORKSPACE && (PWORKSPACE->m_renderOffset->isBeingAnimated() || PWORKSPACE->m_alpha->isBeingAnimated() || PWORKSPACE->m_forceRendering)))
+                    continue;
+
+                if (w->m_monitor != pMonitor)
+                    continue;
+            }
+
+            if (!Fullscreen::controller()->isFullscreen(w))
+                continue;
+
+            if (w->m_monitor == pWorkspace->m_monitor && pWorkspace->m_isSpecialWorkspace != w->onSpecialWorkspace())
+                continue;
+
+            if (renderer.shouldRenderWindow(w, pMonitor))
+                window(w, pMonitor, time, Fullscreen::controller()->getFullscreenModes(pWorkspace).internal != Fullscreen::FSMODE_FULLSCREEN, RENDER_PASS_ALL);
+
+            if (w->m_workspace != pWorkspace)
+                continue;
+
+            pWorkspaceWindow = w;
+        }
+
+        if (!pWorkspaceWindow)
+            return; // this will produce one blank frame. Oh well.
