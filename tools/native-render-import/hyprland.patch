@@ -0,0 +1,113 @@
+#include "SHMSnapshot.hpp"
+
+#include <limits>
+#include <new>
+#include <thread>
+#include <utility>
+
+namespace {
+    class CControlSnapshotStore {
+      public:
+        CControlSnapshotStore() noexcept : m_owner(std::this_thread::get_id()), m_store(pr_snapshot_store_create(128ULL * 1024ULL * 1024ULL)) {}
+        ~CControlSnapshotStore() { pr_snapshot_store_release(m_store); }
+        CControlSnapshotStore(const CControlSnapshotStore&) = delete;
+        CControlSnapshotStore& operator=(const CControlSnapshotStore&) = delete;
+
+        int32_t capture(PrShmDescription description, const uint8_t* pixels, uint64_t bytes, PrSnapshot** result) noexcept {
+            if (std::this_thread::get_id() != m_owner)
+                return PR_INVALID;
+            if (!m_store)
+                return PR_ALLOCATION;
+            if (m_nextImport == std::numeric_limits<uint64_t>::max())
+                return PR_CAPACITY;
+            // A key identifies this immutable content import, not a wl_resource.
+            // Never reuse ids/generations; all successful imports increase all
+            // three fields. Gaps on rejected imports are intentional.
+            const uint64_t sequence = m_nextImport++;
+            description.resource_id = sequence;
+            description.generation = sequence;
+            description.commit_sequence = sequence;
+            return pr_snapshot_capture(m_store, &description, pixels, bytes, result);
+        }
+
+      private:
+        std::thread::id m_owner;
+        PrSnapshotStore* m_store = nullptr;
+        uint64_t m_nextImport = 1;
+    };
+
+    CControlSnapshotStore& controlStore() {
+        // Initialized only by the existing serialized surface-commit owner.
+        // Rust's budget remains alive if snapshot handles outlive the store.
+        static CControlSnapshotStore store;
+        return store;
+    }
+}
+
+Render::CSHMSnapshot::~CSHMSnapshot() {
+    reset();
+}
+
+Render::CSHMSnapshot::CSHMSnapshot(const CSHMSnapshot& other) {
+    if (!other.m_snapshot)
+        return;
+    m_snapshot = pr_snapshot_clone(other.m_snapshot);
+    if (!m_snapshot)
+        throw std::bad_alloc();
+}
+
+Render::CSHMSnapshot::CSHMSnapshot(CSHMSnapshot&& other) noexcept : m_snapshot(std::exchange(other.m_snapshot, nullptr)) {}
+
+Render::CSHMSnapshot& Render::CSHMSnapshot::operator=(const CSHMSnapshot& other) {
+    if (this == &other)
+        return *this;
+    CSHMSnapshot replacement(other);
+    std::swap(m_snapshot, replacement.m_snapshot);
+    return *this;
+}
+
+Render::CSHMSnapshot& Render::CSHMSnapshot::operator=(CSHMSnapshot&& other) noexcept {
+    if (this != &other) {
+        reset();
+        m_snapshot = std::exchange(other.m_snapshot, nullptr);
+    }
+    return *this;
+}
+
+Render::CSHMSnapshot::operator bool() const noexcept {
+    return m_snapshot != nullptr;
+}
+
+void Render::CSHMSnapshot::reset() noexcept {
+    pr_snapshot_release(std::exchange(m_snapshot, nullptr));
+}
+
+std::optional<PrSnapshotView> Render::CSHMSnapshot::view() const& noexcept {
+    if (!m_snapshot)
+        return std::nullopt;
+    PrSnapshotView view{};
+    if (pr_snapshot_view(m_snapshot, &view) != PR_OK)
+        return std::nullopt;
+    return view;
+}
+
+PrSnapshot* Render::CSHMSnapshot::cloneForTransfer() const noexcept {
+    return m_snapshot ? pr_snapshot_clone(m_snapshot) : nullptr;
+}
+
+PrSnapshot* Render::CSHMSnapshot::releaseForTransfer() && noexcept {
+    return std::exchange(m_snapshot, nullptr);
+}
+
+int32_t Render::CSHMSnapshot::capture(PrShmDescription description, const uint8_t* pixels, uint64_t pixelBytes, CSHMSnapshot& result) noexcept {
+    PrSnapshot* imported = nullptr;
+    const int32_t status = controlStore().capture(description, pixels, pixelBytes, &imported);
+    if (status != PR_OK)
+        return status;
+    if (!imported)
+        return PR_ALLOCATION;
+    CSHMSnapshot replacement;
+    replacement.m_snapshot = imported;
+    result = std::move(replacement);
+    return PR_OK;
+}
