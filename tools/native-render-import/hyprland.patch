+#pragma once
+
+#include "pokelinux_render.h"
+#include <cstdint>
+#include <optional>
+
+namespace Render {
+    // Owns one Rust snapshot handle. Copies explicitly clone a separately owned
+    // handle to the same immutable pixel allocation; moves transfer that handle.
+    // No Wayland, buffer, surface, EGL or other C++ ownership enters Rust.
+    class CSHMSnapshot {
+      public:
+        CSHMSnapshot() noexcept = default;
+        ~CSHMSnapshot();
+        CSHMSnapshot(const CSHMSnapshot& other);
+        CSHMSnapshot(CSHMSnapshot&& other) noexcept;
+        CSHMSnapshot& operator=(const CSHMSnapshot& other);
+        CSHMSnapshot& operator=(CSHMSnapshot&& other) noexcept;
+
+        explicit operator bool() const noexcept;
+        void reset() noexcept;
+        // This borrow is valid only while this owned handle remains alive.
+        std::optional<PrSnapshotView> view() const& noexcept;
+        std::optional<PrSnapshotView> view() const&& = delete;
+        // Each non-null result is a new owned handle for an exclusive transfer.
+        [[nodiscard]] PrSnapshot* cloneForTransfer() const noexcept;
+        [[nodiscard]] PrSnapshot* releaseForTransfer() && noexcept;
+
+        // Control-owner-only import; leaves result unchanged on any failure.
+        // Identity fields are assigned by the monotonic import store, not callers.
+        static int32_t capture(PrShmDescription description, const uint8_t* pixels,
+                               uint64_t pixelBytes, CSHMSnapshot& result) noexcept;
+
+      private:
+        PrSnapshot* m_snapshot = nullptr;
+    };
+}
