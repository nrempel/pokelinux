@@ -0,0 +1,52 @@
+#pragma once
+#include <cstdint>
+
+// Private observation on the existing render event-loop thread. No render policy.
+namespace EndRenderWitness {
+inline constexpr uint32_t MAX_INVOCATIONS = 128;
+inline constexpr uint32_t PHASE_BITS = 5;
+enum class Phase : uint32_t {
+    Entry = 0, RenderPassBefore = 1, RenderPassAfter = 2,
+    OpenGLEndBefore = 3, OpenGLEndAfter = 4, ReadOnlyBranch = 5,
+    FullFakeReturnIntent = 6, SyncSectionBefore = 7, ImplicitBranch = 8,
+    FinishBefore = 9, FinishAfter = 10, FlushBefore = 11, FlushAfter = 12,
+    CallbackBefore = 13, CallbackAfter = 14, ImplicitReturnIntent = 15,
+    FenceCreateBefore = 16, FenceCreateAfter = 17, ExplicitValidBranch = 18,
+    ExplicitFallbackBranch = 19, BodyEndIntent = 20, CleanupEnter = 21,
+    CleanupExit = 22, CallsiteReturned = 23,
+    EglCreateSyncBefore = 24, EglCreateSyncAfter = 25,
+    FenceFlushBefore = 26, FenceFlushAfter = 27,
+    DupNativeFenceBefore = 28, DupNativeFenceAfter = 29,
+};
+void mark(uint32_t invocation, Phase phase) noexcept;
+uint32_t beginInvocation() noexcept;
+void markCurrent(Phase phase) noexcept;
+
+// Existing event-loop context only. Zero masks the parent; destruction restores
+// context without publishing a return or completion mark.
+class InvocationScope {
+  public:
+    explicit InvocationScope(uint32_t invocation) noexcept;
+    ~InvocationScope() noexcept;
+    InvocationScope(const InvocationScope&) = delete;
+    InvocationScope& operator=(const InvocationScope&) = delete;
+  private:
+    uint32_t previous_ = 0;
+};
+
+// The explicit line after the original call is the only return publication.
+// An unconsumed token (another backend or an exception) cannot publish return.
+class Callsite {
+  public:
+    Callsite() noexcept;
+    ~Callsite() noexcept;
+    Callsite(const Callsite&) = delete;
+    Callsite& operator=(const Callsite&) = delete;
+    void returned() noexcept;
+  private:
+    friend uint32_t beginInvocation() noexcept;
+    Callsite* previous_ = nullptr;
+    uint32_t invocation_ = 0;
+    bool entered_ = false;
+};
+}
