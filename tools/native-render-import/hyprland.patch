+#include "EndRenderWitness.hpp"
+#include "../event/EventBus.hpp"
+
+namespace EndRenderWitness {
+namespace {
+// Context only; no new writer thread or asynchronous callback is introduced.
+thread_local uint32_t allocated = 0;
+thread_local bool saturationSent = false;
+thread_local Callsite* pending = nullptr;
+thread_local uint32_t currentInvocation = 0;
+
+void notify(uint32_t detail) noexcept {
+    try {
+        const auto& bus = Event::bus();
+        if (bus)
+            bus->m_events.endRenderPhase.emit(detail);
+    } catch (...) {
+        // Diagnostic listeners cannot change original rendering exception behavior.
+    }
+}
+
+uint32_t allocate() noexcept {
+    if (allocated < MAX_INVOCATIONS)
+        return ++allocated;
+    if (!saturationSent) {
+        saturationSent = true;
+        notify(0); // Transport-only control: set overflow, never commit an invalid ID.
+    }
+    return 0;
+}
+}
+
+void mark(uint32_t invocation, Phase phase) noexcept {
+    const auto numeric = static_cast<uint32_t>(phase);
+    if (invocation == 0 || invocation > MAX_INVOCATIONS || numeric > static_cast<uint32_t>(Phase::DupNativeFenceAfter))
+        return;
+    notify((invocation << PHASE_BITS) | numeric);
+}
+
+InvocationScope::InvocationScope(uint32_t invocation) noexcept : previous_(currentInvocation) {
+    currentInvocation = invocation;
+}
+
+InvocationScope::~InvocationScope() noexcept {
+    currentInvocation = previous_;
+}
+
+void markCurrent(Phase phase) noexcept {
+    mark(currentInvocation, phase);
+}
+
+Callsite::Callsite() noexcept : previous_(pending), invocation_(allocate()) {
+    pending = this;
+}
+
+Callsite::~Callsite() noexcept {
+    if (pending == this)
+        pending = previous_;
+}
+
+uint32_t beginInvocation() noexcept {
+    if (!pending)
+        return allocate();
+    auto* call = pending;
+    pending = call->previous_;
+    call->entered_ = true;
+    return call->invocation_;
+}
+
+void Callsite::returned() noexcept {
+    if (!entered_)
+        return;
+    entered_ = false;
+    mark(invocation_, Phase::CallsiteReturned);
+}
+}
