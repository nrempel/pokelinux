+        EMPTY,
+        WRONG_OWNER_CONTEXT,
+        INVALID_TARGET,
+        INVALID_DRAW,
+        RESOURCE_MISMATCH,
+        SHADER_MISMATCH,
+        UNSUPPORTED_MATERIAL,
+        GL_ERROR,
+    };
