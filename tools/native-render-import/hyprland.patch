+FramePlanResult IHyprRenderer::prepareMonitorFramePlan(PHLMONITOR monitor, SFrameTarget target, uint64_t sceneSequence,
+                                                      uint64_t securityGeneration, const Time::steady_tp& when, bool commit) {
+    if (g_pHyprRenderer.get() != this || !monitor || !sceneSequence || !securityGeneration || !target.outputGeneration || target.width == 0 || target.height == 0 ||
+        target.width > 16384 || target.height > 16384 || target.transformedWidth == 0 || target.transformedHeight == 0 ||
+        target.transformedWidth > 16384 || target.transformedHeight > 16384 || target.width != monitor->m_pixelSize.x || target.height != monitor->m_pixelSize.y ||
+        target.transformedWidth != monitor->m_transformedSize.x || target.transformedHeight != monitor->m_transformedSize.y || target.scale != monitor->m_scale ||
+        !std::isfinite(target.scale) || target.scale <= 0 || target.outputTransform > 7 || target.outputTransform != static_cast<uint32_t>(monitor->m_transform))
+        return std::unexpected(SFramePlanError{eFrameUnavailable::INVALID_TARGET, "invalid or stale copied output target/security identity"});
+    auto saved = std::move(m_renderData);
+    m_renderData = {};
+    Hyprutils::Utils::CScopeGuard restore([&] { m_renderData = std::move(saved); });
+    m_renderData.pMonitor = monitor;
+    setProjectionType(RPT_MONITOR); // CPU matrices only, never beginRender()
+    target.targetProjection = copiedMatrix(monitor->getTransformMatrix());
+    target.scaleMatrix = copiedMatrix(monitor->getScaleMatrix());
+    try {
+        clearCMSettingsCache();
+        return CFramePlanBuilder(*this, monitor, target, sceneSequence, securityGeneration, when, commit).build();
+    } catch (const SFramePlanError& failure) {
+        return std::unexpected(failure);
+    } catch (const std::bad_alloc&) {
+        return std::unexpected(SFramePlanError{eFrameUnavailable::ALLOCATION, "immutable scene metadata/clone allocation failed"});
+    }
+}
